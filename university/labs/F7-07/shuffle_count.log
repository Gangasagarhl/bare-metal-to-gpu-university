listing:   wave_sum.hip, wave_sum_fixed.hip
toolchain: HIP version: 5.7.31921-0; Cuda compilation tools, release 12.0, V12.0.140
command:   for f in wave_sum wave_sum_fixed; do for a in gfx90a gfx1030; do printf '%-15s %-8s ds_bpermute_b32 count: %s\n' $f.hip $a $(./isa_of.sh $f.hip $a | grep -c ds_bpermute_b32); done; HIP_PLATFORM=nvidia CUDA_PATH=/usr hipcc -std=c++17 -x cu -arch=sm_80 -ptx $f.hip -o .tmp_$f.ptx; printf '%-15s %-8s shfl.sync.bfly count:  %s\n' $f.hip sm_80 $(grep -c 'shfl.sync.bfly' .tmp_$f.ptx); done; echo; echo 'PTX shuffle lines of wave_sum.hip (sm_80):'; grep 'shfl.sync.bfly' .tmp_wave_sum.ptx | sed -E 's/^[[:space:]]+//'
