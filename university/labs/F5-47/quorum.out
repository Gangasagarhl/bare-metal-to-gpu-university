n = 3 (majority = 2)
  {1}          | {2,3}         majority rule: right decides  lowest-id rule: both sides decide
  {1,2}        | {3}           majority rule: left decides   lowest-id rule: both sides decide
  {1,3}        | {2}           majority rule: left decides   lowest-id rule: both sides decide
  cuts: 3; both sides decide: majority 0, lowest-id 3; nobody decides: majority 0
n = 4 (majority = 3)
  {1}          | {2,3,4}       majority rule: right decides  lowest-id rule: both sides decide
  {1,2}        | {3,4}         majority rule: nobody decides lowest-id rule: both sides decide
  {1,3}        | {2,4}         majority rule: nobody decides lowest-id rule: both sides decide
  {1,2,3}      | {4}           majority rule: left decides   lowest-id rule: both sides decide
  {1,4}        | {2,3}         majority rule: nobody decides lowest-id rule: both sides decide
  {1,2,4}      | {3}           majority rule: left decides   lowest-id rule: both sides decide
  {1,3,4}      | {2}           majority rule: left decides   lowest-id rule: both sides decide
  cuts: 7; both sides decide: majority 0, lowest-id 7; nobody decides: majority 3
