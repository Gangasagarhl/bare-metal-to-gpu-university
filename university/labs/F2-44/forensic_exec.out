$ ls -l hello hello-arm64 | awk '{print $1, $5, $9}'
-rwxr-xr-x 16072 hello
-rwxr-xr-x 70480 hello-arm64
$ ./hello-arm64
bash: line 1: ./hello-arm64: cannot execute binary file: Exec format error
(exit code: 126)
$ ./elfread hello-arm64 | head -n 1
H type=3 machine=AArch64 entry=0x680 phoff=64 shoff=68688 flags=0x0 ehsize=64 phentsize=56 phnum=9 shentsize=64 shnum=28 shstrndx=27
$ ./elfread hello | head -n 1
H type=3 machine=Advanced Micro Devices X86-64 entry=0x1060 phoff=64 shoff=14088 flags=0x0 ehsize=64 phentsize=56 phnum=13 shentsize=64 shnum=31 shstrndx=30
$ readelf -lW hello-arm64 | grep -A1 INTERP
  INTERP         0x000238 0x0000000000000238 0x0000000000000238 0x00001b 0x00001b R   0x1
      [Requesting program interpreter: /lib/ld-linux-aarch64.so.1]
$ qemu-aarch64 -L /usr/aarch64-linux-gnu ./hello-arm64
ELF lab: hello, reader
