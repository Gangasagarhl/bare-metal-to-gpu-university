$ g++ -std=c++20 -O1 -c samples/hello.cpp -o hello.o
$ g++ -std=c++20 -O1 samples/hello.cpp -o hello
$ g++ -std=c++20 -O1 -static samples/hello.cpp -o hello-static
$ g++ -std=c++20 -O1 -fPIC -shared samples/greet.cpp -o libgreet.so
$ strip hello -o hello-stripped
$ aarch64-linux-gnu-g++ -std=c++20 -O1 samples/hello.cpp -o hello-arm64
$ file hello.o hello hello-static libgreet.so hello-stripped hello-arm64 | sed 's/BuildID\[sha1\]=[0-9a-f]*/BuildID[sha1]=<varies>/'
