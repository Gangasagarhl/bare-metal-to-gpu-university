--- what the program printed
C++ in.read(buf, 16) returned 16 bytes
C++ in.read(buf, 16) returned 16 bytes
C++ in.read(buf, 12000) returned 12000 bytes
C++ in.read(buf, 20000) returned 9968 bytes
--- what strace saw for sample.txt (other files and descriptors left out)
openat(AT_FDCWD, "sample.txt", O_RDONLY) = 3
read(3, "line 0000: the quick brown fox j"..., 8191) = 8191
read(3, "dog\nline 0149: the quick brown f"..., 3841) = 3841
read(3, "the lazy dog\nline 0219: the quic"..., 20000) = 9968
read(3, "", 10032)                      = 0
close(3)                                = 0
