+    check(hipGetLastError(), "launch saxpy");
+    check(hipMemcpy(hY.data(), dY, bytes, hipMemcpyDeviceToHost), "copy back");
 
     int mismatches = 0;
     for (int i = 0; i < n; ++i) {
