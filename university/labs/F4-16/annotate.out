== 1. sequence (202 accesses) ==
#1-#64  read-only scan of offsets 0x00-0xfc (64 reads)
#65      read  0x00 = 0x010000ed
#66      write 0x04 = 0x13579bdf
#67      read  0x04 = 0xeca86420
#68      write 0x08 = 0x00000005
