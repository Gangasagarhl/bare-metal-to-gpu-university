# course robot plan, revision C (pretend values; cite= names the datasheet section)
part mcu 3.0 3.6 4.0 cite=D2:operating-conditions
part imu 1.7 3.6 4.0 cite=D3:electrical-characteristics
part imu2 1.7 3.6 4.0 cite=D3:electrical-characteristics
part motor_driver_v2 4.5 5.5 6.0 cite=D10:recommended-operating-conditions
part encoder_L 4.5 5.5 6.0 cite=D11:electrical
rail 3V3 3.3 0.50 cite=D7:regulator-output
rail 5V 5.0 3.00 cite=D8:regulator-output
power mcu 3V3 0.08 cite=D2:supply-current
power imu 3V3 0.01 cite=D3:supply-current
power imu2 3V3 0.01 cite=D3:supply-current
power encoder_L 5V 0.02 cite=D11:supply-current
power motor_driver_v2 5V 0.02 cite=D10:supply-current
signal ENC_L_A encoder_L mcu 4.4 5.0 0.4 2.3 1.0 4.0 cite=D11:output,D2:io-levels
signal MOT_EN mcu motor_driver_v2 2.9 3.3 0.4 3.5 1.5 6.0 cite=D2:io-levels,D10:logic-inputs
i2c i2c1 imu 0x68 cite=D3:i2c-address
i2c i2c1 imu2 0x68 cite=D3:i2c-address
