matrix
# experiment 1: the classic mismatch, a best-effort sensor driver and a reliable subscriber
topic /scan LaserScan
pub lidar_driver reliability=best_effort durability=volatile depth=5
sub mapper reliability=reliable durability=volatile depth=10
sub viewer reliability=best_effort durability=volatile depth=5
info
# experiment 2: late joiner, durability and history
topic /map OccupancyGrid
pub map_server reliability=reliable durability=transient_local depth=1
sub planner reliability=reliable durability=transient_local depth=1
latejoin 3
topic /map OccupancyGrid
pub map_server reliability=reliable durability=volatile depth=1
sub planner reliability=reliable durability=volatile depth=1
latejoin 3
topic /status Status
pub monitor reliability=reliable durability=transient_local depth=5
sub dashboard reliability=reliable durability=transient_local depth=3
latejoin 8
# experiment 3: deadline
topic /cmd_vel Twist
pub teleop reliability=reliable durability=volatile depth=10 deadline=100
sub base reliability=reliable durability=volatile depth=10 deadline=50
info
deadline 100 40 1000
