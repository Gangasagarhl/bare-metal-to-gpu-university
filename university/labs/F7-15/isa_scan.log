listing:   block_scan.hip
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   for t in gfx90a gfx1100; do hipcc -std=c++17 -O2 --offload-arch=$t --cuda-device-only -S block_scan.hip -o .tmp.s 2>/dev/null || exit 1; echo "--- $t: instruction counts in blockScan"; awk '/^_Z9blockScanPKiPiS1_i:/,/s_endpgm/' .tmp.s | grep -o -E '^[[:space:]]+(ds_bpermute_b32|ds_swizzle_b32|s_barrier|ds_write_b32|ds_store_b32|ds_read_b32|ds_load_b32|global_load_dword|global_load_b32|global_store_dword|global_store_b32)' | sort | uniq -c | sed -E 's/^ +//'; grep -E '^[[:space:]]+\.(group_segment_fixed_size|vgpr_count|wavefront_size):' .tmp.s | sed -E 's/^[[:space:]]+//'; done
date:      2026-10-10T00:35:39Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read generated code
