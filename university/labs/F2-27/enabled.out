$ g++  -Q --help=warnings -x c++ /dev/null | grep -E -- '-W(return-type|sign-compare|parentheses|uninitialized|maybe-uninitialized|conversion|float-conversion|shadow|unused-variable) '
  -Wconversion                		[disabled]
  -Wfloat-conversion          		[disabled]
  -Wmaybe-uninitialized       		[disabled]
  -Wparentheses               		[disabled]
  -Wreturn-type               		
  -Wshadow                    		[disabled]
  -Wsign-compare              		[disabled]
  -Wuninitialized             		[disabled]
  -Wunused-variable           		[disabled]
$ g++ -Wall -Q --help=warnings -x c++ /dev/null | grep -E -- '-W(return-type|sign-compare|parentheses|uninitialized|maybe-uninitialized|conversion|float-conversion|shadow|unused-variable) '
  -Wconversion                		[disabled]
  -Wfloat-conversion          		[disabled]
  -Wmaybe-uninitialized       		[enabled]
  -Wparentheses               		[enabled]
  -Wreturn-type               		[enabled]
  -Wshadow                    		[disabled]
  -Wsign-compare              		[enabled]
  -Wuninitialized             		[enabled]
  -Wunused-variable           		[enabled]
$ g++ -Wall -Wextra -Q --help=warnings -x c++ /dev/null | grep -E -- '-W(return-type|sign-compare|parentheses|uninitialized|maybe-uninitialized|conversion|float-conversion|shadow|unused-variable) '
  -Wconversion                		[disabled]
  -Wfloat-conversion          		[disabled]
  -Wmaybe-uninitialized       		[enabled]
  -Wparentheses               		[enabled]
  -Wreturn-type               		[enabled]
  -Wshadow                    		[disabled]
  -Wsign-compare              		[enabled]
  -Wuninitialized             		[enabled]
  -Wunused-variable           		[enabled]
$ g++ --help=warnings | grep -E -- '^  -W(all|extra|pedantic|error|conversion|shadow|sign-conversion|return-type|maybe-uninitialized|unused-variable) '
  -Wall                       Enable most warning messages.
  -Wconversion                Warn for implicit type conversions that may
  -Wextra                     Print extra (possibly unwanted) warnings.
  -Wmaybe-uninitialized       Warn about maybe uninitialized automatic
  -Wpedantic                  Issue warnings needed for strict compliance to
  -Wreturn-type               Warn whenever a function's return type defaults
  -Wshadow                    Warn when one variable shadows another.  Same as
  -Wsign-conversion           Warn for implicit type conversions between signed
  -Wunused-variable           Warn when a variable is unused.
