command:   nvcc -arch=sm_80 -cubin -maxrregcount=16 -Xptxas -v rowsums.cu -o .r.cubin 2>&1 | grep -E 'warning|Used|spill' | sed 's/^ *//'; echo '--- opcode counts'; cuobjdump -sass .r.cubin | grep -E '^[[:space:]]+/\*[0-9a-f]{4}\*/' | grep -oE '(LDG|STG|STL|LDL|FFMA|FMUL|FADD|BRA)[.A-Z0-9]*' | sort | uniq -c; echo '--- memory instructions and branches, in order'; cuobjdump -sass .r.cubin | grep -E '^[[:space:]]+/\*[0-9a-f]{4}\*/' | sed -E 's#^[[:space:]]+/\*([0-9a-f]+)\*/[[:space:]]+(.*[^[:space:]])[[:space:]]*;.*#\1  \2#' | grep -v -E '  NOP$' | grep -E 'LDG|STG|STL|LDL|BRA'
