 1  gcc        reads step5_kernel.cu          writes *step5_kernel.cpp4.ii           preprocess only
 2  cudafe++   reads *step5_kernel.cpp4.ii    writes *step5_kernel.cudafe1.cpp       
 3  gcc        reads step5_kernel.cu          writes *step5_kernel.cpp1.ii           preprocess only; __CUDA_ARCH__ defined
 4  cicc       reads *step5_kernel.cpp1.ii    writes *step5_kernel.ptx               
 5  ptxas      reads *step5_kernel.ptx        writes *step5_kernel.sm_52.cubin       
 6  fatbinary  reads -                        writes *step5_kernel.fatbin.c          
 7  gcc        reads *step5_kernel.cudafe1.cpp writes *step5_kernel.o                 __CUDA_ARCH__ defined
 8  nvlink     reads -                        writes *step5_kernel_dlink.sm_52.cubin 
 9  fatbinary  reads -                        writes *step5_kernel_dlink.fatbin.c    
10  gcc        reads -                        writes *step5_kernel_dlink.o           
11  g++        reads -                        writes step5_kernel                    
