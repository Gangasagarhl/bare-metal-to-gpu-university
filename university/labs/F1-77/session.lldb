register read pc sp xpsr
memory read --size 4 --format x --count 4 0x0
breakpoint set --name Reset_Handler
continue
breakpoint set --name SysTick_Handler
continue
bt
register read lr xpsr
print ticks
continue
print ticks
breakpoint delete --force
watchpoint set variable ticks
continue
memory read --size 4 --format x --count 3 0xE000E010
