  15:	cmp    $0x8,%eax
  18:	jne    8 <_Z13leafWithArrayi+0x8>
  1a:	mov    -0x1c(%rsp),%eax
  1e:	mov    -0x14(%rsp),%edx
  22:	add    %edx,%eax
  24:	ret
