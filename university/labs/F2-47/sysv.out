$ g++ -std=c++20 -O2 -fcf-protection=none -c abi/abi_demo.cpp -o sysv.o
$ objdump --no-show-raw-insn -d sysv.o | sed -n '/<_Z4sum8llllllll>:/,/^$/p'
0000000000000000 <_Z4sum8llllllll>:
   0:	add    %rsi,%rdi
   3:	add    %rdx,%rdi
   6:	add    %rcx,%rdi
   9:	add    %r8,%rdi
   c:	lea    (%rdi,%r9,1),%rax
  10:	add    0x8(%rsp),%rax
  15:	add    0x10(%rsp),%rax
  1a:	ret
  1b:	nopl   0x0(%rax,%rax,1)

$ objdump --no-show-raw-insn -d sysv.o | sed -n '/<_Z7pairSum4Pair>:/,/^$/p'
0000000000000020 <_Z7pairSum4Pair>:
  20:	lea    (%rdi,%rsi,1),%rax
  24:	ret
  25:	data16 cs nopw 0x0(%rax,%rax,1)

$ objdump --no-show-raw-insn -d sysv.o | sed -n '/<_Z7makeBigl>:/,/^$/p'
0000000000000030 <_Z7makeBigl>:
  30:	lea    0x1(%rsi),%rdx
