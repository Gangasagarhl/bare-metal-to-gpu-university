  3e:	lea    0x2(%rsi),%rdx
  42:	add    $0x3,%rsi
  46:	mov    %rdx,0x10(%rdi)
  4a:	mov    %rsi,0x18(%rdi)
  4e:	ret
  4f:	nop

$ objdump --no-show-raw-insn -d sysv.o | sed -n '/<_Z3mixidid>:/,/^$/p'
0000000000000050 <_Z3mixidid>:
  50:	movapd %xmm0,%xmm2
  54:	pxor   %xmm0,%xmm0
  58:	cvtsi2sd %edi,%xmm0
