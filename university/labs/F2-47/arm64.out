$ aarch64-linux-gnu-g++ -std=c++20 -O2 -c abi/abi_demo.cpp -o arm64.o
$ aarch64-linux-gnu-objdump --no-show-raw-insn -d arm64.o | sed -n '/<_Z4sum8llllllll>:/,/^$/p'
0000000000000000 <_Z4sum8llllllll>:
   0:	add	x0, x0, x1
   4:	add	x0, x0, x2
   8:	add	x0, x0, x3
   c:	add	x0, x0, x4
  10:	add	x0, x0, x5
  14:	add	x0, x0, x6
  18:	add	x0, x0, x7
  1c:	ret

$ aarch64-linux-gnu-objdump --no-show-raw-insn -d arm64.o | sed -n '/<_Z7makeBigl>:/,/^$/p'
0000000000000030 <_Z7makeBigl>:
  30:	add	x3, x0, #0x1
  34:	add	x2, x0, #0x2
  38:	add	x1, x0, #0x3
  3c:	stp	x0, x3, [x8]
  40:	stp	x2, x1, [x8, #16]
  44:	ret
  48:	nop
  4c:	nop

$ aarch64-linux-gnu-objdump --no-show-raw-insn -d arm64.o | sed -n '/<_Z8callsOutl>:/,/^$/p'
0000000000000064 <_Z8callsOutl>:
  64:	stp	x29, x30, [sp, #-16]!
  68:	mov	x29, sp
  6c:	bl	0 <_Z8externall>
  70:	add	x0, x0, #0x1
  74:	ldp	x29, x30, [sp], #16
  78:	ret
