# suite.in - the MP2 milestone 1 starter suite. One block per scenario.
# Times are simulated milliseconds. Targets: a server id, leader, follower, down, all.
# Every run also gets, automatically: heal + restart all at "settle", liveness
# probes every 100 ms after settle, and the four checks of harness.h.

scenario calm                 # no faults: the baseline for every other row
seed 1

scenario leader-crash         # the leader dies twice; the first one comes back
seed 11
at 500 crash leader
at 900 restart down
at 1100 crash leader

scenario leader-isolated      # the old leader keeps believing it leads
seed 12
at 500 isolate leader
at 1500 heal

scenario minority-cut         # servers 1 and 2 against servers 3, 4, 5
seed 13
at 400 partition 1 2
at 1500 heal

scenario flapping-link        # the leader drops off and comes back, over and over
seed 14
at 500 isolate leader
at 650 heal
at 800 isolate leader
at 950 heal
at 1100 isolate leader
at 1250 heal

scenario lossy-network        # 10 % loss, 5 % duplicates, delays up to 40 ms
seed 15
net 1 40 10 5
end 4500

scenario crash-everyone       # every server loses its memory at the same moment
seed 16
at 700 crash all
at 1000 restart all

scenario random-nemesis       # generated schedules, as in DS302's fuzz.h
seeds 1 30
net 1 20 2 1
nemesis random 300 3000 150

scenario leader-hunter        # generated schedules that go after the leader
seeds 1 30
net 1 20 2 1
nemesis hunter 300 3000 50
