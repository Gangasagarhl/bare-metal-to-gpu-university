# startup.in - F9-68: the course robot's units (times are the design's estimates in ms)
# unit NAME START_MS READY_MS [needs=..] [after=..] [fail]
unit estop_monitor   5   5
unit logger          10  20
unit dds_discovery   20  200 needs=logger
unit imu_driver      30  80  needs=estop_monitor
unit motor_bridge    30  400 needs=estop_monitor
unit camera_driver   50  900 needs=logger
unit state_estimator 40  30  needs=imu_driver,dds_discovery
unit controller      40  10  needs=state_estimator,motor_bridge
unit planner         100 300 needs=state_estimator after=camera_driver
unit robot_ready     0   0   needs=controller,planner
