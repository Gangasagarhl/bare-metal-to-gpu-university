$ ld.lld -m elf_i386 -T kernel/higher.ld boot.o kmain.o -o higher.elf
$ readelf -hW higher.elf | grep -E 'Entry point'
  Entry point address:               0xc010000c
$ readelf -lW higher.elf | sed -n '/Program Headers/,/Section to Segment/p' | grep -v 'Section to Segment'
Program Headers:
  Type           Offset   VirtAddr   PhysAddr   FileSiz MemSiz  Flg Align
  LOAD           0x001000 0xc0100000 0x00100000 0x00355 0x00355 R E 0x1000
  LOAD           0x002000 0xc0101000 0x00101000 0x0016c 0x0016c R   0x1000
  LOAD           0x003000 0xc0102000 0x00102000 0x00004 0x00004 RW  0x1000
  LOAD           0x004000 0xc0103000 0x00103000 0x00000 0x04004 RW  0x1000
  GNU_STACK      0x000000 0x00000000 0x00000000 0x00000 0x00000 RW  0

$ nm -n higher.elf | grep -E ' (_start|kmain|__kernel_start|__bss_end|g_initialised)$'
c0100000 T __kernel_start
c010000c T _start
c0100030 T kmain
c0102000 D g_initialised
c0107004 B __bss_end
