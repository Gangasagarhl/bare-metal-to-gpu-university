$ ld.lld -m elf_i386 -T kernel/link.ld -Map=fixed.map boot.o kmain.o tables.o -o fixed.elf
$ echo "multiboot magic found at file offset: $(grep -obUaP '\x02\xb0\xad\x1b' fixed.elf | head -n 1 | cut -d: -f1)"
multiboot magic found at file offset: 4096
$ timeout 20 qemu-system-x86_64 -display none -serial none -no-reboot -debugcon stdio -device isa-debug-exit,iobase=0xf4,iosize=0x04 -kernel fixed.elf | head -n 1
F2-46 kernel: symbols exported by link.ld
