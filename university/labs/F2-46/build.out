$ clang++ --target=i386-unknown-none-elf -std=c++20 -ffreestanding -fno-exceptions -fno-rtti -fno-pic -O2 -Wall -Wextra -Werror -c kernel/kmain.cpp -o kmain.o
$ clang --target=i386-unknown-none-elf -c kernel/boot.S -o boot.o
$ ld.lld -m elf_i386 -T kernel/link.ld -Map=kernel.map boot.o kmain.o -o kernel.elf
