$ clang++ --target=i386-unknown-none-elf -std=c++20 -ffreestanding -fno-exceptions -fno-rtti -fno-pic -O2 -Wall -Wextra -Werror -c forensic/tables.cpp -o tables.o
$ ld.lld -m elf_i386 -T forensic/link_new.ld -Map=new.map boot.o kmain.o tables.o -o new.elf
$ timeout 20 qemu-system-x86_64 -display none -serial none -no-reboot -debugcon stdio -device isa-debug-exit,iobase=0xf4,iosize=0x04 -kernel new.elf
qemu-system-x86_64: Error loading uncompressed kernel without PVH ELF Note
(exit code: 1)
$ ls -l new.elf | awk '{print $5, $9}'
29620 new.elf
$ readelf -lW new.elf | sed -n '/Program Headers/,/Section to Segment/p' | grep -v 'Section to Segment'
Program Headers:
  Type           Offset   VirtAddr   PhysAddr   FileSiz MemSiz  Flg Align
  LOAD           0x001000 0x00100000 0x00100000 0x0416c 0x0416c R   0x1000
  LOAD           0x006000 0x00105000 0x00105000 0x00358 0x00358 R E 0x1000
  LOAD           0x007000 0x00106000 0x00106000 0x00004 0x05004 RW  0x1000
  GNU_STACK      0x000000 0x00000000 0x00000000 0x00000 0x00000 RW  0

$ grep -E '^ +[0-9a-f]+ +[0-9a-f]+ +[0-9a-f]+ +[0-9]+ (\.[a-z]+|.*\.o:\(\.(multiboot|rodata))' new.map
  100000   100000     416c     4 .rodata
  10012c   10012c       40     4         kmain.o:(.rodata)
  10016c   10016c     4000     1         tables.o:(.rodata)
  105000   105000      358    16 .text
  105000   105000        c     4         boot.o:(.multiboot)
  106000   106000        4     4 .data
  107000   107000     4004    16 .bss
       0        0      150     4 .symtab
       0        0       34     1 .shstrtab
       0        0       e9     1 .strtab
$ echo "multiboot magic found at file offset: $(grep -obUaP '\x02\xb0\xad\x1b' new.elf | head -n 1 | cut -d: -f1)"
multiboot magic found at file offset: 24576
