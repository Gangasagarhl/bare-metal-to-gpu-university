listing:   cg_sum.cu
toolchain: Cuda compilation tools, release 12.0, V12.0.140
command:   nvcc -std=c++17 -arch=sm_80 -cubin cg_sum.cu -o .tmp.cubin && for f in _Z7tileSumPKfPfx _Z7gridSumPKfPfS1_x; do echo "--- $f"; cuobjdump -sass -fun $f .tmp.cubin | grep -oE '(SHFL\.[A-Z]+|BAR\.SYNC(\.[A-Z]+)*|RED\.[A-Z0-9.]+|ATOM[A-Z]*\.[A-Z0-9.]+|ATOMG\.[A-Z0-9.]+|MEMBAR\.[A-Z.]+|CCTL\.[A-Z.]+|ERRBAR|BPT\.TRAP|NANOSLEEP|WARPSYNC|LD\.E\.STRONG\.GPU|LDG\.E\.STRONG\.GPU|ST\.E\.STRONG\.GPU) ' | sort | uniq -c | sort -rn; done
date:      2026-10-10T00:35:06Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read generated code
exit code: 0
