mkconfig: dropped CONFIG_ROBOT_RTC_TIMESTAMPS=y because it depends on CONFIG_ROBOT_DRIVER_PL031, which is n
CONFIG_ROBOT_CONTROL_PERIOD_US=1000
CONFIG_ROBOT_DEFAULT_CYCLES=500
CONFIG_ROBOT_SAFE_HOLD_CYCLES=300
CONFIG_ROBOT_DRIVER_PL061=y
CONFIG_ROBOT_DRIVER_PL031=n
CONFIG_ROBOT_RTC_TIMESTAMPS=n
CONFIG_ROBOT_ESTOP=y
CONFIG_ROBOT_REQUIRE_ESTOP_TO_ARM=y
