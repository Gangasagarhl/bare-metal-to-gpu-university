# robot.config - F9-67: the options this image is built with (the course's own options).
# Anything not listed takes the default from mkconfig.py.
CONFIG_ROBOT_CONTROL_PERIOD_US=1000
CONFIG_ROBOT_DEFAULT_CYCLES=500
CONFIG_ROBOT_DRIVER_PL061=y
CONFIG_ROBOT_DRIVER_PL031=y
CONFIG_ROBOT_ESTOP=y
CONFIG_ROBOT_REQUIRE_ESTOP_TO_ARM=y
