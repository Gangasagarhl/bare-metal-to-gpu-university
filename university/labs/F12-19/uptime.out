evidence 1: firmware excerpt of gateway B (time keeping)
    static float uptime_s = 0.0f;        // seconds since boot
    void on_tick_100ms() { uptime_s += 0.1f; }
    double stamp() { return boot_epoch_s + uptime_s; }

