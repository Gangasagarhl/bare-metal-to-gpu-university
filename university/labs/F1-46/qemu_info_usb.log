listing:   hmp.py
toolchain: QEMU emulator version 8.2.2 (Debian 1:8.2.2+ds-0ubuntu1.18)
command:   python3 -I hmp.py 3 "info usb" qemu-system-x86_64 -machine q35 -display none -serial null -nographic -no-reboot -device qemu-xhci,id=xhci -device usb-kbd,bus=xhci.0,port=1,pcap=.kbd.pcap -device usb-hub,bus=xhci.0,port=2,id=hub -device usb-tablet,bus=xhci.0,port=2.1 -device usb-mouse,bus=xhci.0,port=2.2
date:      2026-10-09T19:20:22Z
machine:   Linux x86_64 (cloud build container)
exit code: 0
note:      only the SeaBIOS firmware ran, for about 3 s
