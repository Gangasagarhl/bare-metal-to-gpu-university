listing:   one_mfma.hip.inc
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   for t in gfx908 gfx90a gfx942 gfx1030 gfx1100; do echo "--- $t"; if hipcc -x hip -std=c++17 -O2 --cuda-device-only -S --offload-arch=$t one_mfma.hip.inc -o .tmp.s 2>.tmp.err; then grep -E 'v_mfma' .tmp.s | sed -E 's/^[[:space:]-]+//'; grep -E '^[[:space:]-]+\.agpr_count:' .tmp.s | sed -E 's/^[[:space:]-]+//'; else grep -E 'error' .tmp.err; fi; done
date:      2026-10-10T00:36:00Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read generated code
exit code: 0
