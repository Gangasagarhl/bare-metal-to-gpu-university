listing:   slow_gemm.hip.inc
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   for t in gfx942 gfx90a; do echo "--- built for $t: matrix and FMA instructions in linGemm"; hipcc -x hip -std=c++17 -O2 --cuda-device-only -S --offload-arch=$t slow_gemm.hip.inc -o .tmp.s 2>/dev/null || exit 1; awk '/^_Z7linGemmPKDF16_S0_Pfiii:/,/s_endpgm/' .tmp.s | grep -o -E '^[[:space:]]+(v_mfma[a-z_0-9]*|v_fma[a-z_0-9]*|v_fmac[a-z_0-9]*|v_pk_fma[a-z_0-9]*|v_mad[a-z_0-9]*)' | sort | uniq -c | sed -E 's/^ +//'; echo "total v_mfma: $(grep -c v_mfma .tmp.s)"; done; echo '--- predefined gfx macros when building for gfx942'; hipcc -x hip --offload-arch=gfx942 --cuda-device-only -dM -E slow_gemm.hip.inc 2>/dev/null | grep -E 'define __gfx[0-9a-f]+__ ' | sort
date:      2026-10-10T00:36:09Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read generated code
exit code: 0
