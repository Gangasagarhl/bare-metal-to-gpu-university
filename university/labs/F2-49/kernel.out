$ clang++ --target=i386-unknown-none-elf -std=c++20 -ffreestanding -fno-exceptions -fno-rtti -fno-pic -O2 -Wall -Wextra -Werror -c kernel/kmain.cpp -o kmain.o
$ clang --target=i386-unknown-none-elf -c kernel/boot.S -o boot.o
$ ld.lld -m elf_i386 -T kernel/link.ld boot.o kmain.o -o kernel.elf
$ objdump -d --no-show-raw-insn kernel.elf | grep -E '\s(mov +%cr0|pushf|popf|cli|in |out )' | awk '{$1=""; print}' | sort | uniq -c
      1  cli
      1  in $0xf4,%al
      1  mov %cr0,%esi
     12  out %al,$0xe9
      1  out %al,$0xf4
      1  pushf
$ timeout 20 qemu-system-x86_64 -display none -serial none -no-reboot -debugcon stdio -device isa-debug-exit,iobase=0xf4,iosize=0x04 -kernel kernel.elf
F2-49 kernel: privileged wrappers in ring 0
CR0    = 0x00000011  (bit 0 = 1, bit 31 = 0)
EFLAGS = 0x00000002  (bit 9 after cli = 0)
inb(0xf4) = 0x00000000
(exit code: 33)
