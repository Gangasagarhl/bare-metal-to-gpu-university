listing:   -
toolchain: dpkg-query, apt-cache, uname
command:   echo "OS: $(. /etc/os-release && echo $PRETTY_NAME)"; echo "kernel release: $(uname -r)"; echo 'ROCm packages installed (name version):'; dpkg-query -W -f='  ${Package} ${Version}\n' hipcc libamdhip64-5 libamdhip64-dev libhsa-runtime64-1 rocminfo rocm-device-libs-17 libamd-comgr2 2>/dev/null; echo "archive section of hipcc: $(apt-cache policy hipcc 2>/dev/null | grep -m1 -oE '[a-z]+/(main|universe|restricted|multiverse)')"; if [ -d /opt/rocm ]; then echo '/opt/rocm: present'; else echo '/opt/rocm: absent (packages install under /usr)'; fi; echo "hipconfig --rocmpath: $(hipconfig --rocmpath 2>/dev/null)"
date:      2026-10-10T00:38:55Z
machine:   Linux x86_64 (cloud build container)
exit code: 0
