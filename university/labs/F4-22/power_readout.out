== A. CPUID leaf 6: eax 0x4 ecx 0x0 ==
  eax bit 0 0  digital temperature sensor; /proc/cpuinfo 'dts' not listed
  eax bit 1 0  turbo / dynamic acceleration; /proc/cpuinfo 'ida' not listed
  eax bit 2 1  APIC timer runs in every idle state (ARAT); /proc/cpuinfo 'arat' listed
  eax bit 4 0  power limit notification; /proc/cpuinfo 'pln' not listed
  eax bit 6 0  package thermal management; /proc/cpuinfo 'pts' not listed
  eax bit 7 0  hardware-controlled performance states (HWP); /proc/cpuinfo 'hwp' not listed
  ecx bit 0 0  APERF/MPERF counters; /proc/cpuinfo 'aperfmperf' not listed
  ecx bit 3 0  energy/performance bias; /proc/cpuinfo 'epb' not listed
  agreement: 8 of 8 bits
