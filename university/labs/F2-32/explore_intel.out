$ g++ -O2 -std=c++20 -S -o - -masm=intel -fno-asynchronous-unwind-tables -fcf-protection=none explore.cc | grep -v -E '^[[:space:]]*(\.(file|text|globl|type|size|ident|section|p2align|align|cfi|LFB|LFE)|#|\.LF)' | grep -v -E '^\.(LF[BE][0-9]+|Lfunc_end[0-9]+):|^[[:space:]]*\.addrsig' | c++filt | sed -n '/divide_by_8_signed/,/ret/p'
divide_by_8_signed(int):
	test	edi, edi
	lea	eax, 7[rdi]
	cmovns	eax, edi
	sar	eax, 3
	ret
