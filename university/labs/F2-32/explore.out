$ g++ -O0 -std=c++20 -S -o - -fno-asynchronous-unwind-tables -fcf-protection=none explore.cc | grep -v -E '^[[:space:]]*(\.(file|text|globl|type|size|ident|section|p2align|align|cfi|LFB|LFE)|#|\.LF)' | grep -v -E '^\.(LF[BE][0-9]+|Lfunc_end[0-9]+):|^[[:space:]]*\.addrsig' | c++filt
divide_by_8(unsigned int):
	pushq	%rbp
	movq	%rsp, %rbp
	movl	%edi, -4(%rbp)
	movl	-4(%rbp), %eax
	shrl	$3, %eax
	popq	%rbp
	ret
divide_by_8_signed(int):
	pushq	%rbp
	movq	%rsp, %rbp
	movl	%edi, -4(%rbp)
	movl	-4(%rbp), %eax
	leal	7(%rax), %edx
	testl	%eax, %eax
	cmovs	%edx, %eax
	sarl	$3, %eax
	popq	%rbp
	ret
in_range(int):
	pushq	%rbp
	movq	%rsp, %rbp
	movl	%edi, -4(%rbp)
	cmpl	$9, -4(%rbp)
	jle	.L6
	cmpl	$19, -4(%rbp)
	jg	.L6
	movl	$1, %eax
	jmp	.L7
.L6:
	movl	$0, %eax
.L7:
	popq	%rbp
	ret
square(int):
	pushq	%rbp
	movq	%rsp, %rbp
	movl	%edi, -4(%rbp)
	movl	-4(%rbp), %eax
	imull	%eax, %eax
	popq	%rbp
	ret
$ g++ -O2 -std=c++20 -S -o - -fno-asynchronous-unwind-tables -fcf-protection=none explore.cc | grep -v -E '^[[:space:]]*(\.(file|text|globl|type|size|ident|section|p2align|align|cfi|LFB|LFE)|#|\.LF)' | grep -v -E '^\.(LF[BE][0-9]+|Lfunc_end[0-9]+):|^[[:space:]]*\.addrsig' | c++filt
divide_by_8(unsigned int):
	movl	%edi, %eax
	shrl	$3, %eax
	ret
divide_by_8_signed(int):
	testl	%edi, %edi
	leal	7(%rdi), %eax
	cmovns	%edi, %eax
	sarl	$3, %eax
	ret
in_range(int):
	subl	$10, %edi
	cmpl	$9, %edi
	setbe	%al
	ret
square(int):
	imull	%edi, %edi
	movl	%edi, %eax
	ret
$ clang++ -O2 -std=c++20 -S -o - -fno-asynchronous-unwind-tables -fcf-protection=none explore.cc | grep -v -E '^[[:space:]]*(\.(file|text|globl|type|size|ident|section|p2align|align|cfi|LFB|LFE)|#|\.LF)' | grep -v -E '^\.(LF[BE][0-9]+|Lfunc_end[0-9]+):|^[[:space:]]*\.addrsig' | c++filt
divide_by_8(unsigned int):                       # @divide_by_8(unsigned int)
	movl	%edi, %eax
	shrl	$3, %eax
	retq
divide_by_8_signed(int):                # @divide_by_8_signed(int)
	leal	7(%rdi), %eax
	testl	%edi, %edi
	cmovnsl	%edi, %eax
	sarl	$3, %eax
	retq
in_range(int):                           # @in_range(int)
	addl	$-10, %edi
	cmpl	$10, %edi
	setb	%al
	retq
square(int):                             # @square(int)
	movl	%edi, %eax
	imull	%edi, %eax
	retq
