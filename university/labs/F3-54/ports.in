# ports.in - F3-54: an illustrative ports tree for myos. Names follow the curriculum's U4 list
# (a shell, a make tool, a small editor, a compression library, a scripting language, the U1
# test suites); versions and dependencies are the university's illustration, not the real
# projects' requirements, which each recipe author must read from the project's documentation.
libc 0.4: kernel-headers
kernel-headers 0.4:
libm 0.4: libc
zlib-port 1.0: libc
shell-port 1.0: libc
make-port 1.0: libc
termlib-port 1.0: libc
editor-port 1.0: libc termlib-port
lua-port 1.0: libc libm
u1-tests 1.0: libc make-port shell-port
