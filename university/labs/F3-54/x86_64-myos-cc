#!/usr/bin/env bash
# x86_64-myos-cc - F3-54: the ports system's compiler wrapper for the target x86_64-unknown-myos,
# standing in for a patched compiler driver. It compiles with Clang for the myos triple against
# the myos sysroot only (no host headers), and links with LLD against the sysroot's start file
# and C library only (no host libraries). Usage: x86_64-myos-cc -o out file.c ...
set -eu
SYSROOT="${MYOS_SYSROOT:?set MYOS_SYSROOT to the sysroot folder}"
CFLAGS="--target=x86_64-unknown-myos -D__myos__=1 -std=c17 -O2 -ffreestanding -fno-stack-protector -fno-pic"
CFLAGS="$CFLAGS -nostdinc -isystem $SYSROOT/usr/include -Wall -Wextra -Wpedantic -Werror"
out=""; srcs=()
while [ $# -gt 0 ]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        *) srcs+=("$1"); shift ;;
    esac
done
objs=()
for s in "${srcs[@]}"; do
    clang $CFLAGS -c "$s" -o "$out.$(basename "$s").o"
    objs+=("$out.$(basename "$s").o")
done
ld.lld -static -o "$out" "$SYSROOT/usr/lib/crt0.o" "${objs[@]}" -L "$SYSROOT/usr/lib" -lc
rm -f "${objs[@]}"
