$ make main.o sensor.o board.o
g++ -std=c++20 -O1 -Wall -Wextra -Werror -c main.cpp -o main.o
g++ -std=c++20 -O1 -Wall -Wextra -Werror -c sensor.cpp -o sensor.o
g++ -std=c++20 -O1 -Wall -Wextra -Werror -c board.cpp -o board.o
$ make oven OBJS='main.o sensor.o board.o'
g++ -std=c++20 -O1 -Wall -Wextra -Werror -Wl,-Map=oven.map main.o sensor.o board.o -o oven
$ ./oven
board on_overheat(97): HEATER OFF
$ nm -C oven | grep on_overheat
00000000000011a2 T on_overheat(int)
$ make clean
rm -f *.o oven oven.map
