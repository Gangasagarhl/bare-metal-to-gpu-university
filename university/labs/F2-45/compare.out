$ diff <(canon_readobj.sh app.efi | tr A-F a-f) <(./pe_read app.efi | tr A-F a-f) && echo "MATCH app.efi: $(./pe_read app.efi | wc -l) lines"
MATCH app.efi: 26 lines
$ diff <(canon_readobj.sh app.obj | tr A-F a-f) <(./pe_read app.obj | tr A-F a-f) && echo "MATCH app.obj: $(./pe_read app.obj | wc -l) lines"
MATCH app.obj: 16 lines
