$ clang++ --target=x86_64-unknown-windows -std=c++20 -ffreestanding -fno-exceptions -fno-rtti -mno-red-zone -O2 -Wall -Wextra -Werror -c efi/app.cpp -o app.obj
$ lld-link /subsystem:efi_application /entry:efi_main /nodefaultlib /Brepro /out:app.efi app.obj
$ clang++ --target=x86_64-unknown-none-elf -std=c++20 -ffreestanding -fno-exceptions -fno-rtti -mno-red-zone -O2 -Wall -Wextra -Werror -c efi/app.cpp -o app.o
$ file app.obj app.efi app.o
