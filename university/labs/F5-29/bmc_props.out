$ qemu-system-x86_64 -device help | grep -i ipmi
name "smbus-ipmi", bus i2c-bus
name "ipmi-bmc-extern"
name "ipmi-bmc-sim"
name "isa-ipmi-bt", bus ISA
name "isa-ipmi-kcs", bus ISA
name "pci-ipmi-bt", bus PCI, desc "PCI IPMI BT"
name "pci-ipmi-kcs", bus PCI, desc "PCI IPMI KCS"
$ qemu-system-x86_64 -device ipmi-bmc-sim,help
ipmi-bmc-sim options:
  device_id=<uint8>      -  (default: 32)
  device_rev=<uint8>     -  (default: 0)
  fruareasize=<uint16>   -  (default: 1024)
  frudatafile=<str>
  fwrev1=<uint8>         -  (default: 0)
  fwrev2=<uint8>         -  (default: 0)
  guid=<str>             - UUID (aka GUID) or "auto" for random value (default)
  ipmi_version=<uint8>   -  (default: 2)
  mfg_id=<uint32>        -  (default: 0)
  product_id=<uint16>    -  (default: 0)
  sdrfile=<str>
  slave_addr=<uint8>     -  (default: 32)
$ qemu-system-x86_64 -device isa-ipmi-kcs,help
isa-ipmi-kcs options:
  bmc=<link<ipmi-bmc>>
  ioport=<uint32>        -  (default: 3234)
  irq=<int32>            -  (default: 5)
