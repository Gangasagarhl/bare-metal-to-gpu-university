/ {
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    compatible = "sifive,hifive-unleashed-a00";
    model = "SiFive HiFive Unleashed A00";
    chosen {
        stdout-path = "/soc/serial@10010000";
    };
    aliases {
        serial0 = "/soc/serial@10010000";
        serial1 = "/soc/serial@10011000";
        ethernet0 = "/soc/ethernet@10090000";
    };
    gpio-restart {
        compatible = "gpio-restart";
        gpios = <0x7 0xa 0x1>;
    };
    cpus {
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        timebase-frequency = <0xf4240>;
        cpu@0 {
            device_type = "cpu";
            reg = <0x0>;
            status = "okay";
            compatible = "riscv";
            riscv,isa = "rv64imac_zicntr_zicsr_zifencei_zihpm";
            interrupt-controller {
                #interrupt-cells = <0x1>;
                interrupt-controller = (empty);
                compatible = "riscv,cpu-intc";
                phandle = <0x4>;
            };
        };
        cpu@1 {
            device_type = "cpu";
            reg = <0x1>;
            status = "okay";
            compatible = "riscv";
            riscv,isa = "rv64imafdc_zicntr_zicsr_zifencei_zihpm";
            mmu-type = "riscv,sv48";
            interrupt-controller {
                #interrupt-cells = <0x1>;
                interrupt-controller = (empty);
                compatible = "riscv,cpu-intc";
                phandle = <0x3>;
            };
        };
    };
    memory@80000000 {
        device_type = "memory";
        reg = <0x0 0x80000000 0x0 0x10000000>;
    };
    rtcclk {
        #clock-cells = <0x0>;
        compatible = "fixed-clock";
        clock-frequency = <0xf4240>;
        clock-output-names = "rtcclk";
        phandle = <0x2>;
    };
    hfclk {
        #clock-cells = <0x0>;
        compatible = "fixed-clock";
        clock-frequency = <0x1fca055>;
        clock-output-names = "hfclk";
        phandle = <0x1>;
    };
    soc {
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        compatible = "simple-bus";
        ranges = (empty);
        serial@10010000 {
            interrupts = <0x4>;
            interrupt-parent = <0x6>;
            clocks = <0x5 0x3>;
            reg = <0x0 0x10010000 0x0 0x1000>;
            compatible = "sifive,uart0";
        };
        serial@10011000 {
            interrupts = <0x5>;
            interrupt-parent = <0x6>;
            clocks = <0x5 0x3>;
            reg = <0x0 0x10011000 0x0 0x1000>;
            compatible = "sifive,uart0";
        };
        pwm@10021000 {
            #pwm-cells = <0x0>;
            clocks = <0x5 0x3>;
            interrupts = <0x2e 0x2f 0x30 0x31>;
            interrupt-parent = <0x6>;
            reg = <0x0 0x10021000 0x0 0x1000>;
            compatible = "sifive,pwm0";
        };
        pwm@10020000 {
            #pwm-cells = <0x0>;
            clocks = <0x5 0x3>;
            interrupts = <0x2a 0x2b 0x2c 0x2d>;
            interrupt-parent = <0x6>;
            reg = <0x0 0x10020000 0x0 0x1000>;
            compatible = "sifive,pwm0";
        };
        ethernet@10090000 {
            #size-cells = <0x0>;
            #address-cells = <0x1>;
            local-mac-address = [52 54 00 12 34 56];
            clock-names = "pclk", "hclk";
            clocks = <0x5 0x2 0x5 0x2>;
            interrupts = <0x35>;
            interrupt-parent = <0x6>;
            phy-handle = <0x8>;
            phy-mode = "gmii";
            reg-names = "control";
            reg = <0x0 0x10090000 0x0 0x2000 0x0 0x100a0000 0x0 0x1000>;
            compatible = "sifive,fu540-c000-gem";
            ethernet-phy@0 {
                reg = <0x0>;
                phandle = <0x8>;
            };
        };
        spi@10040000 {
            compatible = "sifive,spi0";
            reg = <0x0 0x10040000 0x0 0x1000>;
            interrupt-parent = <0x6>;
            interrupts = <0x33>;
            clocks = <0x5 0x3>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            flash@0 {
                compatible = "jedec,spi-nor";
                reg = <0x0>;
                spi-max-frequency = <0x2faf080>;
                m25p,fast-read = (empty);
                spi-tx-bus-width = <0x4>;
                spi-rx-bus-width = <0x4>;
            };
        };
        spi@10050000 {
            compatible = "sifive,spi0";
            reg = <0x0 0x10050000 0x0 0x1000>;
            interrupt-parent = <0x6>;
            interrupts = <0x6>;
            clocks = <0x5 0x3>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            mmc@0 {
                compatible = "mmc-spi-slot";
                reg = <0x0>;
                spi-max-frequency = <0x1312d00>;
                voltage-ranges = <0xce4 0xce4>;
                disable-wp = (empty);
            };
        };
        cache-controller@2010000 {
            compatible = "sifive,fu540-c000-ccache";
            cache-block-size = <0x40>;
            cache-level = <0x2>;
            cache-sets = <0x400>;
            cache-size = <0x200000>;
            cache-unified = (empty);
            interrupt-parent = <0x6>;
            interrupts = <0x1 0x2 0x3>;
            reg = <0x0 0x2010000 0x0 0x1000>;
        };
        dma@3000000 {
            compatible = "sifive,fu540-c000-pdma";
            reg = <0x0 0x3000000 0x0 0x100000>;
            interrupt-parent = <0x6>;
            interrupts = <0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e>;
            #dma-cells = <0x1>;
        };
        gpio@10060000 {
            compatible = "sifive,gpio0";
            interrupt-parent = <0x6>;
            interrupts = <0x7 0x8 0x9 0xa 0xb 0xc 0xd 0xe 0xf 0x10 0x11 0x12 ... (16 cells)>;
            reg = <0x0 0x10060000 0x0 0x1000>;
            gpio-controller = (empty);
            #gpio-cells = <0x2>;
            interrupt-controller = (empty);
            #interrupt-cells = <0x2>;
            clocks = <0x5 0x3>;
            phandle = <0x7>;
        };
        interrupt-controller@c000000 {
            phandle = <0x6>;
            riscv,ndev = <0x35>;
            reg = <0x0 0xc000000 0x0 0x4000000>;
            interrupts-extended = <0x4 0xb 0x3 0xb 0x3 0x9>;
            interrupt-controller = (empty);
            compatible = "sifive,plic-1.0.0", "riscv,plic0";
            #interrupt-cells = <0x1>;
        };
        clock-controller@10000000 {
            compatible = "sifive,fu540-c000-prci";
            reg = <0x0 0x10000000 0x0 0x1000>;
            clocks = <0x1 0x2>;
            #clock-cells = <0x1>;
            phandle = <0x5>;
        };
        otp@10070000 {
            compatible = "sifive,fu540-c000-otp";
            reg = <0x0 0x10070000 0x0 0x1000>;
            fuse-count = <0x1000>;
        };
        clint@2000000 {
            interrupts-extended = <0x4 0x3 0x4 0x7 0x3 0x3 0x3 0x7>;
            reg = <0x0 0x2000000 0x0 0x10000>;
            compatible = "sifive,clint0", "riscv,clint0";
        };
    };
};
