listing:   spin_warp.cu, kernel countSpinLock
toolchain: Cuda compilation tools, release 12.0, V12.0.140; Cuda compilation tools, release 12.0, V12.0.140 (cuobjdump)
command:   for a in sm_60 sm_80; do nvcc -arch=$a -cubin spin_warp.cu -o .bin_spin.cubin && echo "--- $a" && cuobjdump -sass -fun _Z13countSpinLockv .bin_spin.cubin | tr -d '{}' | grep -E '^[[:space:]]+/\*[0-9a-f]{4}\*/' | sed -E 's#^[[:space:]]+/\*([0-9a-f]+)\*/[[:space:]]+([^;]*[^;[:space:]])[[:space:]]*;?.*#\1  \2#' | grep -v -E '  NOP$' | sed -E '/^0*([0-9a-f]+)  BRA 0x\1$/d'; done
date:      2026-10-10T02:39:14Z
machine:   Linux x86_64 (cloud build container), 4 CPUs visible
hardware:  compiled only: no GPU is needed to read generated code
exit code: 0
