# F1-75 clock-tree configurations for the teaching chip U-MCU-1 (input of Listing 1)
# 1. straight after reset: everything runs from the internal RC oscillator
config reset-default
enable uart1
baud uart1 115200

# 2. full speed from a 12 MHz crystal through the PLL
config crystal-72MHz
xtal 12000000
pllsrc xtal
pllmul 6
sysclk pll
apb1 2
enable uart1
enable uart2
enable tim2
baud uart1 115200
baud uart2 115200

# 3. the same, but APB1 left undivided
config apb1-too-fast
xtal 12000000
pllsrc xtal
pllmul 6
sysclk pll
enable uart2
baud uart2 115200
