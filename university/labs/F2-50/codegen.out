$ g++ -std=c++20 -O2 -fcf-protection=none -Wall -Wextra -Werror -c host/regs_codegen.cpp -o codegen.o
$ objdump -d --no-show-raw-insn codegen.o | sed -n '/<_Z15setModeBitfieldPV8CtrlBits>:/,/^$/p'
0000000000000000 <_Z15setModeBitfieldPV8CtrlBits>:
   0:	mov    (%rdi),%eax
   2:	and    $0xfffffff1,%eax
   5:	or     $0xa,%eax
   8:	mov    %eax,(%rdi)
   a:	ret
   b:	nopl   0x0(%rax,%rax,1)

