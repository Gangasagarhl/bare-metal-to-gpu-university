0000000000000010 <_Z11setModeMaskPVj>:
  10:	mov    (%rdi),%eax
  12:	and    $0xfffffff1,%eax
  15:	or     $0xa,%eax
  18:	mov    %eax,(%rdi)
  1a:	ret
  1b:	nopl   0x0(%rax,%rax,1)

