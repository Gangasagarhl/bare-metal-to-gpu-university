$ clang++ --target=i386-unknown-none-elf -std=c++20 -ffreestanding -fno-exceptions -fno-rtti -fno-pic -Wall -Wextra -Werror -O2 -I kernel -c forensic/kmain_fast.cpp -o fast_O2.o
