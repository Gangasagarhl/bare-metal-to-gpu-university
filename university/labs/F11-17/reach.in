# F11-17 lab input: allowed connections in the university's small teaching cluster.
# Node names and services are exercise values for the cluster drawn in Figure 1.
start internet
allow internet login ssh
allow internet monitoring web-dashboard
allow login scheduler job-submit
allow login storage file-access
allow scheduler compute1 job-launch
allow scheduler compute2 job-launch
allow scheduler compute3 job-launch
allow compute1 storage file-access
allow compute2 storage file-access
allow compute3 storage file-access
allow compute1 registry image-pull
allow compute2 registry image-pull
allow compute3 registry image-pull
allow compute3 bmc1 management
allow monitoring bmc1 management
allow monitoring bmc2 management
allow admin-console bmc1 management
allow admin-console bmc2 management
allow admin-console scheduler admin
target scheduler
target storage
target registry
target bmc1
target bmc2
target admin-console
# compute3 was given a second network card on the management network "for debugging";
# the monitoring dashboard is published to the internet and also polls the BMCs.
fix internet monitoring
fix compute3 bmc1
