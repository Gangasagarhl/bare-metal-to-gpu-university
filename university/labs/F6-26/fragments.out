matrix_a 16x16x16 half                       tile 16 x 16 = 256 elements; per thread 16; x 32 threads = 512
matrix_b 16x16x16 half                       tile 16 x 16 = 256 elements; per thread 16; x 32 threads = 512
matrix_a 16x16x16 __nv_bfloat16              tile 16 x 16 = 256 elements; per thread  8; x 32 threads = 256
accumulator 16x16x16 float                   tile 16 x 16 = 256 elements; per thread  8; x 32 threads = 256
accumulator 16x16x16 half                    tile 16 x 16 = 256 elements; per thread  8; x 32 threads = 256
matrix_a 32x8x16 half (A is 32 x 16)         tile 32 x 16 = 512 elements; per thread 16; x 32 threads = 512
matrix_a 16x16x8 tf32 (A is 16 x 8)          tile 16 x  8 = 128 elements; per thread  4; x 32 threads = 128
