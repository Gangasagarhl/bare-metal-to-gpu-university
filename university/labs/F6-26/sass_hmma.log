listing:   gemm_wmma.cuh (via wmma_gemm.cu)
toolchain: Cuda compilation tools, release 12.0, V12.0.140
command:   for a in sm_80 sm_90; do nvcc -arch=$a -cubin wmma_gemm.cu -o .tmp_$a.cubin || exit 1; for f in _Z8gemmWmmaI6__halfEvPKT_S3_Pfiii _Z8gemmWmmaI13__nv_bfloat16EvPKT_S3_Pfiii; do printf '%s %s: ' $a $f; cuobjdump -sass -fun $f .tmp_$a.cubin | grep -o -E 'HMMA[.A-Z0-9]*' | sort | uniq -c | tr -s ' ' | tr '\n' ';'; echo; done; done
