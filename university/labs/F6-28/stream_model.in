# F6-28 scenarios. Durations are model time units (invented, not measured).
# Two independent jobs, A and B: copy in 30, kernel 40, copy out 30 each.
scenario one-stream
stream 1 blocking
h2d 1 30 A-in
kernel 1 40 A-kernel
d2h 1 30 A-out
h2d 1 30 B-in
kernel 1 40 B-kernel
d2h 1 30 B-out
end

scenario two-streams
stream 1 blocking
stream 2 blocking
h2d 1 30 A-in
kernel 1 40 A-kernel
d2h 1 30 A-out
h2d 2 30 B-in
kernel 2 40 B-kernel
d2h 2 30 B-out
end

# Job C writes its result into A's output buffer, so C's kernel must not start
# before A's result has been copied out: stream 2 waits for an event recorded in
# stream 1 after A-out. C's copy in (into another buffer) does not need to wait.
scenario event-join
stream 1 blocking
stream 2 blocking
h2d 1 30 A-in
kernel 1 40 A-kernel
d2h 1 30 A-out
record aOutDone 1
h2d 2 30 C-in
wait 2 aOutDone
kernel 2 40 C-kernel
d2h 2 30 C-out
end
