$ g++ -std=c++20 -Wall -Wextra -Werror -O2 -g queue.cc -o queue
$ TIMEFORMAT='wall time %3R s'; time ./queue 10000
printed 10000 tickets, 137500 characters
wall time 0.147 s
$ TIMEFORMAT='wall time %3R s'; time ./queue 20000
printed 20000 tickets, 275000 characters
wall time 0.456 s
$ valgrind --tool=callgrind --callgrind-out-file=q10000.out ./queue 10000 2>&1 | grep -E 'refs'
==<pid>== I   refs:      2,105,051,433
$ valgrind --tool=callgrind --callgrind-out-file=q20000.out ./queue 20000 2>&1 | grep -E 'refs'
==<pid>== I   refs:      8,408,124,813
