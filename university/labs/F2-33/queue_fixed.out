$ g++ -std=c++20 -Wall -Wextra -Werror -O2 -g queue_fixed.cc -o queue_fixed
$ TIMEFORMAT='wall time %3R s'; time ./queue_fixed 10000
printed 10000 tickets, 137500 characters
wall time 0.003 s
$ valgrind --tool=callgrind --callgrind-out-file=qf10000.out ./queue_fixed 10000 2>&1 | grep -E 'refs'
==<pid>== I   refs:      4,995,885
$ TIMEFORMAT='wall time %3R s'; time ./queue_fixed 20000
printed 20000 tickets, 275000 characters
wall time 0.004 s
$ valgrind --tool=callgrind --callgrind-out-file=qf20000.out ./queue_fixed 20000 2>&1 | grep -E 'refs'
==<pid>== I   refs:      8,017,759
