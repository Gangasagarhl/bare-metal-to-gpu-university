$ printf '# uni_template\n\nRun ./ci.sh to configure, build and test.\n' > README.md && git add README.md
$ git commit -q -m 'docs: add README'
$ cp ./history/stats_nth.cpp src/stats.cpp && git commit -q -am 'stats: faster median with nth_element'
$ sed -i 's/"count %zu mean/"n=%zu mean/' app/main.cpp && git commit -q -am 'app: shorter output'
$ sed -i 's/--parallel 2/--parallel 4/' ci.sh && git commit -q -am 'ci: build with 4 jobs'
$ git log --oneline
e01443a ci: build with 4 jobs
d3f19f0 app: shorter output
1d441cc stats: faster median with nth_element
d204d5d docs: add README
c3e3f00 P1: template with CMake, stats library, tests and ci.sh
$ git show --stat --format='%h %an %ad%n    %s' --date=short HEAD~2
1d441cc Amara Okafor 2026-10-03
    stats: faster median with nth_element

 src/stats.cpp | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)
$ git diff HEAD~3 HEAD~2 -- src/stats.cpp
diff --git a/src/stats.cpp b/src/stats.cpp
index b1d75af..eadc553 100644
--- a/src/stats.cpp
+++ b/src/stats.cpp
@@ -1,6 +1,7 @@
 #include "uni/stats.h"
 
 #include <algorithm>
+#include <cstddef>
 #include <numeric>
 
 namespace uni {
@@ -14,17 +15,15 @@ std::optional<double> mean(const std::vector<double>& xs)
     return sum / static_cast<double>(xs.size());
 }
 
+// Faster: nth_element only partly sorts the data.
 std::optional<double> median(std::vector<double> xs)
 {
     if (xs.empty()) {
         return std::nullopt;
     }
-    std::sort(xs.begin(), xs.end());
     const std::size_t mid = xs.size() / 2;
-    if (xs.size() % 2 == 1) {
-        return xs[mid];
-    }
-    return (xs[mid - 1] + xs[mid]) / 2.0;
+    std::nth_element(xs.begin(), xs.begin() + static_cast<std::ptrdiff_t>(mid), xs.end());
+    return xs[mid];
 }
 
 }  // namespace uni
