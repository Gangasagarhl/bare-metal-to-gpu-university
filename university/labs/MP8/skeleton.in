# skeleton.in - nominal walking-skeleton run: a box stands in the robot's lane from the start.
# Perception every 100 ms, 30 ms from sensor sample to published frame, frames older than
# 250 ms are not used. All times are simulated milliseconds.
end_ms 6000
period_ms 100
delay_ms 30
max_age_ms 250
box_at_ms 0 3.0 1.4 3.3 1.9
consumer_checks_age yes
speed_mm_s 400
decel_mm_s2 2000
lookahead_mm 500
goal_x_mm 5300
