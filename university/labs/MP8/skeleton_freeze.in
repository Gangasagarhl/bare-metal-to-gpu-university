# skeleton_freeze.in - fault injection: perception stops publishing at t = 2000 ms (a hung
# GPU kernel); a box appears in the lane at t = 3000 ms. The controller checks frame age.
end_ms 6000
period_ms 100
delay_ms 30
max_age_ms 250
freeze_at_ms 2000
box_at_ms 3000 2.6 1.4 2.9 1.9
consumer_checks_age yes
speed_mm_s 400
decel_mm_s2 2000
lookahead_mm 500
goal_x_mm 5300
