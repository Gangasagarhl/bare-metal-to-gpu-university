# MP6 milestone M1 starter: mission and stack configuration (our own format, not ROS 2 parameters).
# Every value is a choice of this lab plan; none is data of a real kit.
seed 1
dock 1.00 1.90 0.00
# stop <name> <x m> <y m> <heading rad> <dwell s>: pick up at the kitchen table, deliver to the bedroom, return
stop pickup 5.40 1.50 0.00 2.0
stop drop 3.20 5.00 3.14 2.0
stop dock 1.00 1.90 0.00 0.0
# reflector posts: id, map position (m)
post 0 0.25 2.50
post 1 3.80 0.30
post 2 3.80 3.30
post 3 4.20 0.30
post 4 7.75 3.30
post 5 4.20 3.70
post 6 6.50 5.75
post 7 0.25 3.70
post 8 3.80 5.75
post 9 7.75 0.30
# software calibration (the simulated kit's truth is the same unless a true_* key changes it)
wheel_radius 0.050
track 0.300
encoder_cpr 1024
nis_gate 9.21
# navigation and task
nav_max_vel 0.30
xy_goal_tolerance 0.10
yaw_goal_tolerance 0.15
task_tolerance 0.20
time_limit 300
# safety supervisor
speed_limit 0.30
watchdog 0.25
