// cstdint - F4-30: the three freestanding C++ headers DR402's neutral code includes, for CPUs
// with no hosted C++ library installed in the build container (clang can target them, but
// libstdc++'s headers pull in glibc headers that exist only for x86-64 here). Only what the
// tests use is provided. On a real port the toolchain's own freestanding headers replace these.
#pragma once
#include <stdint.h>   // clang's own header in -ffreestanding mode
namespace std {
using ::int8_t; using ::int16_t; using ::int32_t; using ::int64_t;
using ::uint8_t; using ::uint16_t; using ::uint32_t; using ::uint64_t;
using ::intptr_t; using ::uintptr_t;
}
