// atomic - F4-30: the part of std::atomic that DR402's neutral code uses (load, store,
// fetch_add, compare_exchange_strong), written on the compiler's __atomic built-ins, which is
// also how the real library implements it. See cstdint for why these shims exist.
#pragma once
namespace std {

enum memory_order : int {
    memory_order_relaxed = __ATOMIC_RELAXED,
    memory_order_consume = __ATOMIC_CONSUME,
    memory_order_acquire = __ATOMIC_ACQUIRE,
    memory_order_release = __ATOMIC_RELEASE,
    memory_order_acq_rel = __ATOMIC_ACQ_REL,
    memory_order_seq_cst = __ATOMIC_SEQ_CST,
};

template <class T>
class atomic {
public:
    constexpr atomic() noexcept : v_() {}
    constexpr atomic(T v) noexcept : v_(v) {}
    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;

    T load(memory_order o = memory_order_seq_cst) const noexcept { return __atomic_load_n(&v_, o); }
    void store(T v, memory_order o = memory_order_seq_cst) noexcept { __atomic_store_n(&v_, v, o); }
    T fetch_add(T d, memory_order o = memory_order_seq_cst) noexcept { return __atomic_fetch_add(&v_, d, o); }
    bool compare_exchange_strong(T& expected, T desired, memory_order o = memory_order_seq_cst) noexcept
    {
        // failure order: acq_rel -> acquire, release -> relaxed (as the standard requires)
        int f = o == memory_order_acq_rel ? __ATOMIC_ACQUIRE : o == memory_order_release ? __ATOMIC_RELAXED : o;
        return __atomic_compare_exchange_n(&v_, &expected, desired, false, o, f);
    }

private:
    alignas(sizeof(T)) T v_;
};

} // namespace std
