listing:   gemm_tiled.cuh (via sgemm_tiled.cu)
toolchain: Cuda compilation tools, release 12.0, V12.0.140
command:   nvcc -arch=sm_80 -cubin sgemm_tiled.cu -o .tmp.cubin && for f in _Z10sgemmTiledILi16EEvPKfS1_Pfiii _Z10sgemmTiledILi32EEvPKfS1_Pfiii; do echo "--- $f: instruction mix"; cuobjdump -sass -fun $f .tmp.cubin | grep -E '^[[:space:]]+/\*[0-9a-f]{4}\*/' | sed -E 's#^[[:space:]]+/\*([0-9a-f]+)\*/[[:space:]]+(.*[^[:space:]])[[:space:]]*;.*#\1  \2#' | grep -o -E '(LDG[.A-Z0-9]*|STS[.A-Z0-9]*|LDS[.A-Z0-9]*|FFMA|BAR[.A-Z0-9]*|STG[.A-Z0-9]*)' | sort | uniq -c; done; echo '--- sgemmTiled<32>: first shared-memory loads and multiply-adds of the inner loop'; cuobjdump -sass -fun _Z10sgemmTiledILi32EEvPKfS1_Pfiii .tmp.cubin | grep -E '^[[:space:]]+/\*[0-9a-f]{4}\*/' | sed -E 's#^[[:space:]]+/\*([0-9a-f]+)\*/[[:space:]]+(.*[^[:space:]])[[:space:]]*;.*#\1  \2#' | grep -E 'LDS|FFMA' | head -n 10
