listing:   wave_info.hip
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   for t in gfx90a gfx942 gfx1030 gfx1100; do m=$(hipcc --offload-arch=$t --cuda-device-only -dM -E wave_info.hip 2>/dev/null | grep -E 'define __AMDGCN_WAVEFRONT_SIZE ' | awk '{print $3}'); hipcc -std=c++17 -O2 --offload-arch=$t --cuda-device-only -S wave_info.hip -o .tmp.s 2>/dev/null; w=$(grep -E '^[[:space:]]+\.wavefront_size:' .tmp.s | awk '{print $2}'); echo "$t: __AMDGCN_WAVEFRONT_SIZE=$m  .wavefront_size=$w"; done
date:      2026-10-10T00:41:59Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read generated code
exit code: 0
