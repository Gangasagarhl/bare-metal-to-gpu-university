listing:   probe_amd.hip and probe.cu
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) via hipcc (HIP 5.7); Cuda compilation tools, release 12.0, V12.0.140
command:   echo '--- gfx90a (hipcc): the store of warpSize and the kernel metadata'; hipcc -std=c++17 -O2 --offload-arch=gfx90a --cuda-device-only -S probe_amd.hip -o .tmp.s 2>/dev/null && grep -E 'v_mov_b32.*(64|0x40)|\.wavefront_size:' .tmp.s | sed -E 's/^[[:space:]]+//'; echo '--- sm_80 (nvcc): PTX, then SASS'; nvcc -arch=sm_80 -ptx probe.cu -o .tmp.ptx && grep -E 'WARP_SZ' .tmp.ptx | sed -E 's/^[[:space:]]+//'; nvcc -arch=sm_80 -cubin probe.cu -o .tmp.cubin && cuobjdump -sass .tmp.cubin | grep -E 'MOV.*0x20|IMAD.MOV.*0x20' | sed -E 's#^[[:space:]]+/\*[0-9a-f]+\*/[[:space:]]+##; s#[[:space:]]*;.*##'
date:      2026-10-09T19:27:51Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read generated code
exit code: 0
