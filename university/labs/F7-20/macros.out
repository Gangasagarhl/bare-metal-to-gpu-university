--- hipcc host pass
#define __AMDGCN_WAVEFRONT_SIZE 64
#define __HIP_PLATFORM_AMD__ 
--- hipcc device pass gfx90a
#define __AMDGCN_WAVEFRONT_SIZE 64
#define __HIP_DEVICE_COMPILE__ 1
#define __HIP_PLATFORM_AMD__ 
#define __gfx90a__ 1
--- hipcc device pass gfx1100
#define __AMDGCN_WAVEFRONT_SIZE 32
#define __HIP_DEVICE_COMPILE__ 1
#define __HIP_PLATFORM_AMD__ 
#define __gfx1100__ 1
--- nvcc device pass sm_80 (value of __CUDA_ARCH__ printed by a test macro)
host pass: __CUDA_ARCH__ not defined
	mov.u32 	%r1, 800;
