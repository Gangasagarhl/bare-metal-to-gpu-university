// reduce.cu, as ported by hipify (sample input for hazards.cpp)
#define WARP_SIZE 32
__device__ float warpSum(float v)
{
    for (int d = 16; d > 0; d /= 2) {
        v += __shfl_xor(v, d);
    }
    return v;
}
__global__ void blockSum(const float* x, float* out, int n)
{
    __shared__ float partial[WARP_SIZE];
    int i = blockIdx.x * blockDim.x + threadIdx.x;
    int lane = threadIdx.x % 32;
    int warp = threadIdx.x / 32;
    float v = (i < n) ? x[i] : 0.0f;
    v = warpSum(v);
    unsigned int active = __ballot(v != 0.0f);
    if (lane == 0) partial[warp] = v;
    __syncthreads();
    if (warp == 0) {
        v = (lane < blockDim.x / WARP_SIZE) ? partial[lane] : 0.0f;
        v = warpSum(v);
        if (lane == 0) atomicAdd(out, v);
    }
    (void)active;
}
void launch(const float* x, float* out, int n)
{
    blockSum<<<(n + 255) / 256, 256>>>(x, out, n);
    unsigned mask = 0xffffffff;
    (void)mask;
}
