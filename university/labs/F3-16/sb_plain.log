listing:   sbstate.cc (as \EFI\BOOT\BOOTX64.EFI)
toolchain: Ubuntu clang version 18.1.3 (1ubuntu1); Ubuntu LLD 18.1.3; QEMU emulator version 8.2.2 (Debian 1:8.2.2+ds-0ubuntu1.18); OVMF from the ovmf package 2024.02-2ubuntu0.10
command:   python3 ../F3-10/qemu_run.py --timeout 60 --stop-after 'Press any key to enter the Boot Manager' -- qemu-system-x86_64 -machine q35 -m 256M -display none -serial stdio -no-reboot -net none -drive if=pflash,format=raw,readonly=on,file=OVMF_CODE_4M.fd -drive if=pflash,format=raw,file=OVMF_VARS_4M.fd(copy) -drive format=raw,file=fat:rw:esp -device isa-debug-exit,iobase=0xf4,iosize=0x04
