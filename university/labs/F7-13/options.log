listing:   dot.hip
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   for f in '' '-munsafe-fp-atomics' '-ffp-contract=fast'; do echo "--- dot() with options: ${f:-(none)}"; hipcc -std=c++17 -O2 --offload-arch=gfx90a --cuda-device-only $f -S dot.hip -o .tmp.s 2>/dev/null; awk '/^_Z3dot.*:/,/s_endpgm/' .tmp.s | grep -v -E '^[[:space:]]*;' | sed -E 's/[[:space:]]*;.*$//' > .tmp.k; printf 'global_atomic_cmpswap: %s   global_atomic_add_f32: %s\n' $(grep -c global_atomic_cmpswap .tmp.k) $(grep -c global_atomic_add_f32 .tmp.k); printf 'in loop .LBB0_2: v_pk_mul_f32: %s   v_fma*/v_fmac*: %s   v_add_f32: %s\n' $(awk '/^.LBB0_2:/,/s_cbranch_execnz/' .tmp.k | grep -c v_pk_mul_f32) $(awk '/^.LBB0_2:/,/s_cbranch_execnz/' .tmp.k | grep -c -E 'v_fma|v_fmac|v_pk_fma') $(awk '/^.LBB0_2:/,/s_cbranch_execnz/' .tmp.k | grep -c v_add_f32); done
