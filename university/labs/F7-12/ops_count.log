listing:   wave_ops.hip
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   for t in gfx90a gfx1100; do hipcc -std=c++17 -O2 --offload-arch=$t --cuda-device-only -S wave_ops.hip -o .tmp.s 2>/dev/null; awk '/^_Z13sumAndCompact.*:/,/s_endpgm/' .tmp.s | grep -v -E '^[[:space:]]*;' | sed -E 's/[[:space:]]*;.*$//' > .tmp.k; echo "--- $t (.wavefront_size $(grep -E '^[[:space:]]+\.wavefront_size:' .tmp.s | awk '{print $2}'))"; for op in ds_bpermute_b32 v_mbcnt_lo_u32_b32 v_mbcnt_hi_u32_b32 v_bcnt_u32_b32 s_bcnt1_i32_b32 s_bcnt1_i32_b64 s_and_saveexec_b32 s_and_saveexec_b64; do printf '%-22s %s\n' $op $(grep -c -w $op .tmp.k); done; done
date:      2026-10-10T00:43:07Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read generated code
exit code: 0
