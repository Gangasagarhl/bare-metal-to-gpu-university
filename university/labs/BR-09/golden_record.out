$ while IFS= read -r line; do out="$(./build/stats_cli $line 2>&1)"; code=$?; printf '%s -> %s [exit %d]\n' "$line" "$out" "$code"; done < <lab>/prod/tests/golden_inputs.txt > <work>/golden_now.txt; cat <work>/golden_now.txt
