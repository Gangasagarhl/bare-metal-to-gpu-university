$ echo '$ stats_cli 3 1 2'; ./build/gcc-debug-asan/stats_cli 3 1 2; echo "exit status: $?"
$ stats_cli 3 1 2
count 3 mean 2 median 2
exit status: 0
$ echo '$ stats_cli '; ./build/gcc-debug-asan/stats_cli ; echo "exit status: $?"
$ stats_cli 
stats_cli: error E-USAGE: no numbers given
usage: stats_cli <number>...   |   stats_cli --version
exit status: 2
$ echo '$ stats_cli abc'; ./build/gcc-debug-asan/stats_cli abc; echo "exit status: $?"
$ stats_cli abc
stats_cli: error E-PARSE: argument 1 "abc" is not a number
exit status: 3
$ echo '$ stats_cli 1e999'; ./build/gcc-debug-asan/stats_cli 1e999; echo "exit status: $?"
$ stats_cli 1e999
stats_cli: error E-PARSE: argument 1 "1e999" is outside the range of double
exit status: 3
$ echo '$ stats_cli 3abc 1 2'; ./build/gcc-debug-asan/stats_cli 3abc 1 2; echo "exit status: $?"
$ stats_cli 3abc 1 2
stats_cli: error E-PARSE: argument 1 "3abc" has characters after the number
exit status: 3
$ echo '$ stats_cli 0x10'; ./build/gcc-debug-asan/stats_cli 0x10; echo "exit status: $?"
$ stats_cli 0x10
stats_cli: error E-PARSE: argument 1 "0x10" has characters after the number
exit status: 3
$ echo '$ stats_cli 4,4 4.2'; ./build/gcc-debug-asan/stats_cli 4,4 4.2; echo "exit status: $?"
$ stats_cli 4,4 4.2
stats_cli: error E-PARSE: argument 1 "4,4" has characters after the number
exit status: 3
$ echo '$ stats_cli nan 1 2'; ./build/gcc-debug-asan/stats_cli nan 1 2; echo "exit status: $?"
$ stats_cli nan 1 2
stats_cli: error E-PARSE: argument 1 "nan" is not a finite number
exit status: 3
$ echo '$ stats_cli 1 nan 2'; ./build/gcc-debug-asan/stats_cli 1 nan 2; echo "exit status: $?"
$ stats_cli 1 nan 2
stats_cli: error E-PARSE: argument 2 "nan" is not a finite number
exit status: 3
$ echo '$ stats_cli 1 2 nan'; ./build/gcc-debug-asan/stats_cli 1 2 nan; echo "exit status: $?"
$ stats_cli 1 2 nan
stats_cli: error E-PARSE: argument 3 "nan" is not a finite number
exit status: 3
$ echo '$ stats_cli 1e308 1e308'; ./build/gcc-debug-asan/stats_cli 1e308 1e308; echo "exit status: $?"
$ stats_cli 1e308 1e308
stats_cli: error E-RANGE: result does not fit in a double (see KNOWN_ISSUES.md, KI-1)
exit status: 4
$ echo '$ stats_cli 1234567 1234568'; ./build/gcc-debug-asan/stats_cli 1234567 1234568; echo "exit status: $?"
$ stats_cli 1234567 1234568
count 2 mean 1.23457e+06 median 1.23457e+06
exit status: 0
$ echo '$ stats_cli --version'; ./build/gcc-debug-asan/stats_cli --version; echo "exit status: $?"
$ stats_cli --version
stats_cli 1.0.0
exit status: 0
