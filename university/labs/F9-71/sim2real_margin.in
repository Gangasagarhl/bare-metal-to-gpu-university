# sim2real_margin.in - F9-71 worked example: the delay margin, saturation, and a reversed CPR error
# case NAME DELAY_MS FRICTION NOISE VBAT CPR_TRUE CPR_ASSUMED   (VBAT 1000 = practically no saturation)
case no_saturation   0  0    0   1000 0    0
case +delay_17ms     17 0    0   12   0    0
case +delay_18ms     18 0    0   12   0    0
case +delay_19ms     19 0    0   12   0    0
case +delay_20ms     20 0    0   12   0    0
case +delay_22ms     22 0    0   12   0    0
case delay_22_nosat  22 0    0   1000 0    0
case cpr_1024_as2048 0  0    0   12   1024 2048
