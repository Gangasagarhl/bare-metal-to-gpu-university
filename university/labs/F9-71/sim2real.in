# sim2real.in - F9-71: one controller, eight motors
# case NAME DELAY_MS FRICTION NOISE VBAT CPR_TRUE CPR_ASSUMED   (CPR 0 = perfect speed sensor)
case ideal_sim       0  0    0   12 0    0
case +encoder        0  0    0   12 1024 1024
case +delay_5ms      5  0    0   12 0    0
case +delay_15ms     15 0    0   12 0    0
case +delay_30ms     30 0    0   12 0    0
case +friction       0  150  0   12 0    0
case +battery_sag    0  0    0   7  0    0
case all_together    5  150  1   9  1024 1024
