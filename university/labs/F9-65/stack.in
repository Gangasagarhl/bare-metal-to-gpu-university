# stack.in - F9-65: the course robot's stack (budgets are design budgets, not measurements)
# component NAME LAYER CPU PERIOD_US BUDGET_US CRITICALITY   (cpu 9 = the motor microcontroller)
component motor_mcu_fw     hardware_io 9 1000   200   high
component imu_driver       drivers     1 1000   50    high
component motor_bridge     drivers     1 1000   80    high
component camera_driver    drivers     2 33333  3000  low
component lidar_driver     drivers     2 100000 4000  low
component dds_middleware   middleware  2 10000  1500  low
component state_estimator  estimation  1 2000   300   high
component controller       control     1 1000   150   high
component detector         perception  3 33333  20000 low
component planner          planning    3 100000 30000 low
component logger           operations  2 10000  1000  low
component health_monitor   operations  1 10000  100   high
chain control_path imu_driver state_estimator controller motor_bridge motor_mcu_fw
chain see_and_avoid camera_driver detector planner controller motor_bridge
