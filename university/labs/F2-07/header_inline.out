$ mkdir -p inline && cp main.cpp report.cpp inline/ && sed 's/^void print_banner/inline void print_banner/' banner.h > inline/banner.h
$ grep -n 'print_banner()$' inline/banner.h
7:inline void print_banner()
$ g++ -std=c++20 -Wall -Wextra -Wpedantic -Werror -g -fsanitize=address,undefined inline/main.cpp inline/report.cpp -o kitchen
$ ./kitchen
