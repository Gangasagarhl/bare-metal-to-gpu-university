# Description of the course's model flight controller (after review)
board uni_fc_model
console UART7 PE8 PE7
spi SPI1 PC2 imu0 0x47
spi SPI1 PD7 baro0 0x50
spi SPI4 PE4 imu1 0x12
i2c I2C1 0x1e mag0 0x3d
pwm 1 TIM1 CH4 PE14 400
pwm 2 TIM1 CH3 PE13 400
pwm 3 TIM1 CH2 PE11 400
pwm 4 TIM1 CH1 PE9 400
pwm 5 TIM4 CH1 PD12 50
pwm 6 TIM4 CH2 PD13 50
led LED_RED PB1
led LED_BLUE PB3
