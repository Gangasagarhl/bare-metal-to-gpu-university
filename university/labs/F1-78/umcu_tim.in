## Part A - the reference solution: TIM2 update event every 1 s (72 MHz TIM2CLK)
# 14.5 step 1: clock first
write RCC_APB1ENR 1
# 14.2: CK_CNT = 72 MHz / (7199 + 1) = 10 kHz; 14.1: 10000 counts per period -> ARR = 9999
write TIM2_PSC 7199
write TIM2_ARR 9999
# 14.5 step 3: load PSC now, then clear the flag that UG set (w1c: write 1)
write TIM2_EGR 1
write TIM2_SR 1
read TIM2_SR
write TIM2_CR1 1
blink 3 1
## Part B - PWM on CH1: 1 kHz, 25 % (CK_CNT = 72 MHz, ARR + 1 = 72000 is too big for 16 bits,
## so PSC = 1: CK_CNT = 36 MHz, ARR = 35999, CCR1 = 9000)
write TIM2_CR1 0
write TIM2_PSC 1
write TIM2_ARR 35999
write TIM2_CCR1 9000
write TIM2_CCMR1 0x60
write TIM2_CCER 1
write TIM2_EGR 1
write TIM2_SR 1
write TIM2_CR1 1
pwm 7200000
## Part C - worked example of F1-78: UIF every 250 ms (PSC 7199, ARR 2499)
write TIM2_CR1 0
write TIM2_PSC 7199
write TIM2_ARR 2499
write TIM2_CCER 0
write TIM2_EGR 1
write TIM2_SR 1
write TIM2_CR1 1
blink 3 1
