## Part A - the reference solution: TIM2 update event every 1 s (72 MHz TIM2CLK)
write RCC_APB1ENR = 1
write TIM2_PSC = 7199
write TIM2_ARR = 9999
write TIM2_EGR = 1
write TIM2_SR = 1
read  TIM2_SR -> 0x0
write TIM2_CR1 = 1
blink: wait for UIF, write 1 to TIM2_SR, toggle LED
  LED toggle 1 at t = 1000.000 ms (1000.000 ms after the previous)
  LED toggle 2 at t = 2000.000 ms (1000.000 ms after the previous)
  LED toggle 3 at t = 3000.000 ms (1000.000 ms after the previous)
## Part B - PWM on CH1: 1 kHz, 25 % (CK_CNT = 72 MHz, ARR + 1 = 72000 is too big for 16 bits,
## so PSC = 1: CK_CNT = 36 MHz, ARR = 35999, CCR1 = 9000)
write TIM2_CR1 = 0
write TIM2_PSC = 1
write TIM2_ARR = 35999
write TIM2_CCR1 = 9000
write TIM2_CCMR1 = 0x60
write TIM2_CCER = 1
write TIM2_EGR = 1
write TIM2_SR = 1
write TIM2_CR1 = 1
pwm over 100.000 ms: 100 rising edges (1000.0 Hz), high 25.0 % of the time
## Part C - worked example of F1-78: UIF every 250 ms (PSC 7199, ARR 2499)
write TIM2_CR1 = 0
write TIM2_PSC = 7199
write TIM2_ARR = 2499
write TIM2_CCER = 0
write TIM2_EGR = 1
write TIM2_SR = 1
write TIM2_CR1 = 1
blink: wait for UIF, write 1 to TIM2_SR, toggle LED
  LED toggle 1 at t = 3350.000 ms (250.000 ms after the previous)
  LED toggle 2 at t = 3600.000 ms (250.000 ms after the previous)
  LED toggle 3 at t = 3850.000 ms (250.000 ms after the previous)
