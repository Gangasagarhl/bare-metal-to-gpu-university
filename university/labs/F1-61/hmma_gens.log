listing:   wmma_tile.cu
toolchain: Cuda compilation tools, release 12.0, V12.0.140
command:   for a in sm_70 sm_75 sm_80 sm_86 sm_90; do nvcc -arch=$a -cubin wmma_tile.cu -o .tmp_$a.cubin || exit 1; printf '%-6s ' $a; cuobjdump -sass .tmp_$a.cubin | grep -o -E 'HMMA[.A-Z0-9_]*' | sort | uniq -c | tr -s ' ' | tr '\n' ';'; echo; done
