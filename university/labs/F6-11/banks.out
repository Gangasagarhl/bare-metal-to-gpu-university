model: 32 banks x 4 bytes, 32 lanes, 4-byte elements

access pattern (lane = 0..31)                passes  gcd(stride,32)
a[lane * 1]                                  1       1
a[lane * 2]                                  2       2
a[lane * 3]                                  1       1
a[lane * 4]                                  4       4
a[lane * 5]                                  1       1
a[lane * 8]                                  8       8
a[lane * 16]                                 16      16
a[lane * 17]                                 1       1
a[lane * 32]                                 32      32
a[lane * 33]                                 1       1

special cases                                passes 
a[0] (every lane the same word: broadcast)   1      
a[lane / 2] (pairs share a word)             1      
char c[lane] (four lanes per word)           1      
a[(lane * 7) % 32] (a permutation)           1      

32 x 32 tile, lane = row, fixed column c = 5 passes 
tile[lane][5], pitch 32                      32     
tile[lane][5], pitch 33 (padding)            1      
tile[lane][5 ^ lane], pitch 32 (XOR swizzle) 1      
tile[5][lane ^ 5], pitch 32 (swizzled row)   1      
