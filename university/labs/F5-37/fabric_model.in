# DS401 lab fabric: configuration dump (university format, collected by the operators)
# pair  eth_mtu  roce_path_mtu  qp_dscp  switch_lossless_dscp  pfc_on_lossless_class  ecn_marking  incast_senders
pair A-B  9000  4096  26  26  on   off  4
pair C-D  1500  1024  26  26  off  off  4
# model parameters (chosen for this lab, not measured on any product):
#   loss_lossy  = probability that a packet in a LOSSY class is dropped while incast_senders > 1
#   bdp_bytes   = bytes in flight on the path (bandwidth-delay product)
model loss_lossy 0.002 bdp_bytes 131072 packets 200000
