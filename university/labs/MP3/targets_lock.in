# MP3 targets file, as you receive it. Fill it at gate R1, BEFORE writing any kernel.
# Every value comes from your machine (the device report of F6-07, nvcc --version) and from
# the agreement with your reviewers. A field still holding <...> or ? is not filled.
author <your name>
gpu <GPU name exactly as your device report prints it>
driver <driver version as printed by the tools>
toolkit <toolkit version as printed by nvcc --version>
clocks <locked at which setting, or not-locked and why>
reference sgemm cublasSgemm
reference hgemm <cuBLAS routine for FP16 inputs with FP32 accumulation, from the cuBLAS documentation>
reference attention <the fused attention implementation available on your platform>
# target <kernel> <size> <precision> <percent of the reference, median time>
# sgemm/hgemm size = M = N = K; attention size = sequence length N (one head, d = 64)
target sgemm 1024 fp32 ?
target sgemm 2048 fp32 ?
target sgemm 4096 fp32 ?
target hgemm 4096 fp16 ?
target attention 4096 fp16 ?
tolerance fp32 gammaK-bound-of-mp3_tolerance.hpp
tolerance fp16 F6-25-bound-of-mp3_tolerance.hpp
signed R1 <reviewer> <date>
