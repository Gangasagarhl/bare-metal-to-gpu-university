# MP3 targets of Leila's project, signed at R1 (an EXAMPLE for this handbook).
# The machine is SYNTHETIC: this file and the raw records that go with it test the tools,
# they describe no real GPU. The percentages are Leila's plan, not a recommendation.
author Leila
gpu SYNTHETIC-TEST-DATA
driver SYNTHETIC-TEST-DATA
toolkit SYNTHETIC-TEST-DATA
clocks not-locked:no-permission-on-the-shared-machine
reference sgemm cublasSgemm
reference hgemm cuBLAS-FP16-in-FP32-acc-routine-named-in-the-design-note
reference attention platform-fused-attention-named-in-the-design-note
target sgemm 1024 fp32 60
target sgemm 2048 fp32 60
target sgemm 4096 fp32 60
target hgemm 4096 fp16 50
target attention 4096 fp16 40
tolerance fp32 gammaK-bound-of-mp3_tolerance.hpp
tolerance fp16 F6-25-bound-of-mp3_tolerance.hpp
signed R1 Tomas 2026-03-02
signed R1 Wanjiru 2026-03-02
# --- raw records written by the harness (SYNTHETIC: invented by synthetic_raw.py) ---
env gpu SYNTHETIC-TEST-DATA
env driver SYNTHETIC-TEST-DATA
env toolkit SYNTHETIC-TEST-DATA
env clocks not-locked:no-permission-on-the-shared-machine
