push a into slot 0  -> head 0, count 1, slots [a - - -]
push b into slot 1  -> head 0, count 2, slots [a b - -]
push c into slot 2  -> head 0, count 3, slots [a b c -]
pop  a from slot 0  -> head 1, count 2, slots [- b c -]
push d into slot 3  -> head 1, count 3, slots [- b c d]
push e into slot 0  -> head 1, count 4, slots [e b c d]
push f: FULL, a producer would wait
pop  b from slot 1  -> head 2, count 3, slots [e - c d]
