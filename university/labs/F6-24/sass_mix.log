command:   nvcc -arch=sm_80 -cubin sgemm_dbuf.cu -o .tmp.cubin && for f in _Z12sgemmRegTileILi64ELi64ELi8ELi4ELi4ELb1ELi1EEvPKfS1_Pfiii _Z17sgemmDoubleBufferILi64ELi64ELi8ELi4ELi4EEvPKfS1_Pfiii; do echo "--- $f"; cuobjdump -sass -fun $f .tmp.cubin | grep -E '^[[:space:]]+/\*[0-9a-f]{4}\*/' | sed -E 's#^[[:space:]]+/\*([0-9a-f]+)\*/[[:space:]]+(.*[^[:space:]])[[:space:]]*;.*#\1  \2#' > .tmp.sass; grep -v '@!PT' .tmp.sass | grep -o -E '(LDS[.A-Z0-9]*|FFMA)' | sort | uniq -c; printf '      (plus %s never-executed "@!PT LDS RZ, [RZ]" lines, not counted)\n' $(grep -c '@!PT LDS' .tmp.sass); done
