<?xml version="1.0"?>
<!-- udialect.xml - F10-30 Listing 1: the university's teaching dialect ("U-link").
     The FILE STRUCTURE (mavlink / enums / messages / message / field / extensions) follows
     the way MAVLink dialect files are organised; the message names, ids and fields are OUR
     OWN, so that nothing here depends on recalling the real common.xml. -->
<mavlink>
  <version>1</version>
  <dialect>0</dialect>
  <enums>
    <enum name="U_MISSION_RESULT">
      <entry value="0" name="U_MISSION_ACCEPTED"/>
      <entry value="1" name="U_MISSION_ERROR"/>
      <entry value="2" name="U_MISSION_NO_SPACE"/>
    </enum>
  </enums>
  <messages>
    <message id="1" name="U_HEARTBEAT">
      <description>I am alive: sent once per second by every system and component.</description>
      <field type="uint8_t" name="type">Vehicle or component type.</field>
      <field type="uint8_t" name="autopilot">Which flight stack (0 = none, e.g. a GCS).</field>
      <field type="uint8_t" name="base_mode">Bit flags; bit 7 = armed.</field>
      <field type="uint32_t" name="custom_mode">Flight mode number, stack-specific.</field>
      <field type="uint8_t" name="system_status">0 = booting, 1 = standby, 2 = active.</field>
    </message>
    <message id="2" name="U_POSITION">
      <description>Local position and velocity.</description>
      <field type="uint32_t" name="time_ms">Time since boot.</field>
      <field type="int32_t" name="x_mm">North, millimetres.</field>
      <field type="int32_t" name="y_mm">East, millimetres.</field>
      <field type="int32_t" name="z_mm">Down, millimetres.</field>
      <field type="int16_t" name="vx_cms">North velocity, cm/s.</field>
      <field type="int16_t" name="vy_cms">East velocity, cm/s.</field>
      <extensions/>
      <field type="uint8_t" name="quality">Estimate quality 0-100 (added in a later version).</field>
    </message>
    <message id="10" name="U_MISSION_COUNT">
      <field type="uint8_t" name="target_system">System that should receive the mission.</field>
      <field type="uint8_t" name="target_component">Component that should receive it.</field>
      <field type="uint16_t" name="count">Number of mission items that will follow.</field>
    </message>
    <message id="11" name="U_MISSION_REQUEST">
      <field type="uint8_t" name="target_system">System that sent the count.</field>
      <field type="uint8_t" name="target_component">Component that sent the count.</field>
      <field type="uint16_t" name="seq">Index of the item the receiver wants next.</field>
    </message>
    <message id="12" name="U_MISSION_ITEM">
      <field type="uint8_t" name="target_system">Receiving system.</field>
      <field type="uint8_t" name="target_component">Receiving component.</field>
      <field type="uint16_t" name="seq">Index of this item.</field>
      <field type="uint8_t" name="frame">Coordinate frame of x, y, z.</field>
      <field type="uint16_t" name="command">What to do at this item (16 = go to).</field>
      <field type="int32_t" name="x">North or latitude, in the frame's unit.</field>
      <field type="int32_t" name="y">East or longitude, in the frame's unit.</field>
      <field type="float" name="z">Altitude, metres.</field>
      <field type="char[8]" name="label">Short name for the ground station.</field>
    </message>
    <message id="13" name="U_MISSION_ACK">
      <field type="uint8_t" name="target_system">System that sent the mission.</field>
      <field type="uint8_t" name="target_component">Component that sent the mission.</field>
      <field type="uint8_t" name="result" enum="U_MISSION_RESULT">Outcome.</field>
    </message>
    <message id="20" name="U_COMMAND">
      <field type="uint8_t" name="target_system">Receiving system.</field>
      <field type="uint8_t" name="target_component">Receiving component.</field>
      <field type="uint16_t" name="command">Command number.</field>
      <field type="uint8_t" name="confirmation">0 first time, then 1, 2 ... on retries.</field>
      <field type="float" name="param1">Meaning depends on the command.</field>
      <field type="float" name="param2">Meaning depends on the command.</field>
      <field type="float" name="param3">Meaning depends on the command.</field>
    </message>
    <message id="21" name="U_COMMAND_ACK">
      <field type="uint16_t" name="command">Command being acknowledged.</field>
      <field type="uint8_t" name="result">0 accepted, 1 temporarily rejected, 2 denied, 3 unsupported.</field>
    </message>
    <message id="30" name="U_STATUSTEXT">
      <field type="uint8_t" name="severity">0 emergency ... 7 debug.</field>
      <field type="char[50]" name="text">Text, not necessarily zero-terminated.</field>
    </message>
  </messages>
</mavlink>
