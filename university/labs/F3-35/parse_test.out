line: echo hello world
  pipeline 0, command 0: argv = [echo] [hello] [world]
line: sort < fruit.txt | head -n 2 > top.txt
  pipeline 0, command 0: argv = [sort]  stdin < fruit.txt
  pipeline 0, command 1: argv = [head] [-n] [2]  stdout > top.txt
line: echo 'a  b' "c $? d" e\ f >> log.txt
  pipeline 0, command 0: argv = [echo] [a  b] [c 1 d] [e f]  stdout >> log.txt
line: false; echo status $?
  pipeline 0, command 0: argv = [false]
  pipeline 1, command 0: argv = [echo] [status] [1]
line: cat file | | wc
  error: empty command
line: echo > 
  error: missing file name after >
line: echo 'unfinished
  error: unterminated '
line: # only a comment
  (nothing to run)
