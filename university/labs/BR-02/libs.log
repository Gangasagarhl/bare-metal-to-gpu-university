listing:   -
toolchain: Linux 6.18.44-fc-v114; dpkg-query
command:   for n in cublas cub thrust hipblas hipcub rocblas rocprim rocthrust; do m=$(ls -d /usr/include/$n /usr/include/$n.h /usr/include/${n}_v2.h /usr/include/$n/ /usr/include/hip/$n* /opt/rocm*/include/$n* 2>/dev/null | sort -u | tr '\n' ' '); printf '%-10s %s\n' $n "${m:-(no header or folder of this name)}"; done; echo; echo 'installed packages whose name contains blas, cub, prim or thrust:'; dpkg-query -W -f='${Package} ${Version}\n' 2>/dev/null | grep -E 'blas|cub|prim|thrust' | grep -vE 'openblas|libblas|liblapack|libcublas[a-z]*-?dev' ; true
date:      2026-10-10T02:42:35Z
machine:   Linux x86_64 (cloud build container)
exit code: 0
