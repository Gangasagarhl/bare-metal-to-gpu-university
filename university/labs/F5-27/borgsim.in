# F5-27 lab cell, invented for the lab: 3 machines; CPU in whole cores; times in minutes.
machine m1 16
machine m2 16
machine m3 16
#     user band  CPU
quota ana  prod   32
quota dev  prod   12
quota cara prod    8
quota ben  batch  40
#    name  user band  limit usage submit work(-1 = service)
task web1  ana  prod    8     3     0     -1
task web2  ana  prod    8     3     0     -1
task web3  ana  prod    8     3     0     -1
task web4  ana  prod    8     3     0     -1
task cache cara prod   12     6     0     -1
task b1    ben  batch   4     4     1     30
task b2    ben  batch   4     4     1     30
task b3    ben  batch   4     4     1     30
task b4    ben  batch   4     4     1     30
task b5    ben  batch   4     4     1     30
task b6    ben  batch   4     4     1     30
task api   dev  prod   12     6    10     -1
horizon 60
reclamation off
reclamation on
