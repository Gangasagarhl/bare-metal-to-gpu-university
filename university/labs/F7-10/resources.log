listing:   pressure.hip
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   hipcc -std=c++17 -O2 --offload-arch=gfx90a --cuda-device-only -c pressure.hip -o /dev/null -Rpass-analysis=kernel-resource-usage 2>&1 | grep -E 'Function Name|SGPRs:|VGPRs:|AGPRs:|ScratchSize|Occupancy|VGPRs Spill|LDS Size' | sed -E 's/.*remark: +//; s/ \[-R.*//; s/ \[bytes\/lane\]//; s/ \[waves\/SIMD\]//; s/ \[bytes\/block\]//' | paste -d ' ' - - - - - - - - | sed -E 's/Function Name: _Z[0-9]+([A-Za-z]+)ILi([0-9]+)E[^ ]*/\1<\2>/' | sed -E 's/  +/ /g'
date:      2026-10-10T00:42:26Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read the compiler's reports
exit code: 0
