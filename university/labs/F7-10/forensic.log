listing:   fir.hip
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   hipcc -std=c++17 -O2 --offload-arch=gfx90a --cuda-device-only -c fir.hip -o /dev/null -Rpass-analysis=kernel-resource-usage 2>&1 | grep -E 'Function Name|SGPRs:|VGPRs:|AGPRs:|ScratchSize|Occupancy|VGPRs Spill|LDS Size' | sed -E 's/.*remark: +//; s/ \[-R.*//; s/ \[bytes\/lane\]//; s/ \[waves\/SIMD\]//; s/ \[bytes\/block\]//' | paste -d ' ' - - - - - - - - | sed -E 's/Function Name: _Z3firILi([0-9]+)E[^ ]*/fir<\1>/; s/  +/ /g'; hipcc -std=c++17 -O2 --offload-arch=gfx90a --cuda-device-only -S fir.hip -o .tmp.s 2>/dev/null; for k in 16 32; do awk -v k="_Z3firILi${k}EEvPKfS1_Pfi:" '$1==k,/s_endpgm/' .tmp.s | sed -E 's/[[:space:]]*;.*$//' > .tmp.k; echo "--- ISA census of fir<$k>"; printf 'instructions:                %s\n' $(grep -c -E '^[[:space:]]+[a-z_0-9]+' .tmp.k); printf 'global_load (any width):     %s\n' $(grep -c 'global_load' .tmp.k); printf 's_load (scalar loads):       %s\n' $(grep -c 's_load' .tmp.k); printf 'v_fmac/v_fma (multiply-add): %s\n' $(grep -c -E 'v_fmac|v_fma_f32|v_pk_fma' .tmp.k); printf 'highest VGPR index written:  v%s\n' $(grep -o -E '\bv\[?[0-9]+' .tmp.k | grep -o -E '[0-9]+' | sort -n | tail -1); printf 'first multiply-add at instruction: %s\n' $(grep -E '^[[:space:]]+[a-z_0-9]+' .tmp.k | grep -n -m1 -E 'v_fmac|v_fma_f32|v_pk_fma' | cut -d: -f1); printf 'global_load before it:       %s\n' $(grep -E '^[[:space:]]+[a-z_0-9]+' .tmp.k | awk '/v_fmac|v_fma_f32|v_pk_fma/ {exit} /global_load/ {c++} END {print c+0}'); done
