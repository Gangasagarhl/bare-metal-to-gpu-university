listing:   pressure.hip
toolchain: Ubuntu clang version 17.0.6 (9ubuntu1) (the compiler that hipcc drives; HIP 5.7)
command:   hipcc -std=c++17 -O2 --offload-arch=gfx90a --cuda-device-only -S pressure.hip -o .tmp.s 2>/dev/null && for k in _Z5accumILi128EEvPKfPfii _Z5accumILi256EEvPKfPfii _Z7accumLBILi256EEvPKfPfii; do echo "--- $k"; awk -v k="$k:" '$1==k,/s_endpgm/' .tmp.s > .tmp.k; printf 'stores marked Spill by the compiler:  %s\n' $(grep -c 'Spill' .tmp.k); printf 'loads marked Reload by the compiler:  %s\n' $(grep -c 'Reload' .tmp.k); printf 'v_accvgpr_write (VGPR -> AGPR):       %s\n' $(grep -c 'v_accvgpr_write' .tmp.k); printf 'v_accvgpr_read  (AGPR -> VGPR):       %s\n' $(grep -c 'v_accvgpr_read' .tmp.k); grep -m 2 -E 'Spill|v_accvgpr_write' .tmp.k | sed -E 's/^[[:space:]]+/    /'; done
