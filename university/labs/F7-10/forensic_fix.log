command:   hipcc -std=c++17 -O2 --offload-arch=gfx90a --cuda-device-only -c fir_fix.hip -o /dev/null -Rpass-analysis=kernel-resource-usage 2>&1 | grep -E 'Function Name|SGPRs:|VGPRs:|AGPRs:|ScratchSize|Occupancy|VGPRs Spill|LDS Size' | sed -E 's/.*remark: +//; s/ \[-R.*//; s/ \[bytes\/lane\]//; s/ \[waves\/SIMD\]//; s/ \[bytes\/block\]//' | paste -d ' ' - - - - - - - - | sed -E 's/Function Name: _Z5firLBILi([0-9]+)ELi([0-9]+)E[^ ]*/firLB<\1,\2>/; s/  +/ /g'
date:      2026-10-10T00:42:51Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read the compiler's reports
exit code: 0
