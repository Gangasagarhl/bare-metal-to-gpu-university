listing:   (tools) lscpu, lspci, command -v
toolchain: lscpu from util-linux 2.39.3; lspci version 3.10.0
command:   echo '--- lscpu (CPU and NUMA lines)'; lscpu | grep -E '^(Socket|NUMA|Core|Thread|Model name)'; echo '--- lspci -tv'; lspci -tv; echo '--- vendor topology tools'; for t in nvidia-smi rocm-smi amd-smi; do command -v $t >/dev/null && echo "$t: installed" || echo "$t: not installed"; done
date:      2026-10-10T00:40:18Z
machine:   Linux x86_64 (cloud build container, no GPU)
exit code: 0
