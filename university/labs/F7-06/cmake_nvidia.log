listing:   proj/CMakeLists.txt
toolchain: cmake version 3.28.3; Cuda compilation tools, release 12.0, V12.0.140; HIP version: 5.7.31921-0 headers
command:   cmake -S proj -B $T/v -DHIP_BACKEND=NVIDIA -DCMAKE_CUDA_ARCHITECTURES=80 -DCMAKE_BUILD_TYPE=Release > /dev/null && cmake --build $T/v -v 2>&1 | grep -E '^/usr/bin/nvcc' | sed -E -e 's# -MD -MT [^ ]+ -MF [^ ]+##' -e "s#$(pwd)/##g" | tr -s ' ' && echo && echo 'GPU code in the executable (cuobjdump --list-elf):' && cuobjdump --list-elf $T/v/saxpy | sed -E 's/tmpxft_[0-9a-f]+_[0-9]+-//'
date:      2026-10-10T00:40:01Z
machine:   Linux x86_64 (cloud build container)
hardware:  compiled only: no GPU is needed to read a build
exit code: 0
