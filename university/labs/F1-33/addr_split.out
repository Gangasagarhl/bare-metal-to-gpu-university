offset bits 6, index bits 6, tag = the remaining high bits
0x0 = 00000000000000000000  tag 0x0  set 0  offset 0
0x40 = 00000000000001000000  tag 0x0  set 1  offset 0
0x1000 = 00000001000000000000  tag 0x1  set 0  offset 0
0x2000 = 00000010000000000000  tag 0x2  set 0  offset 0
0x1040 = 00000001000001000000  tag 0x1  set 1  offset 0
0x3fc0 = 00000011111111000000  tag 0x3  set 63  offset 0
0x12345 = 00010010001101000101  tag 0x12  set 13  offset 5
