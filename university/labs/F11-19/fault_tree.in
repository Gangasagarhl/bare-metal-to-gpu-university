# Top event: the arm's drives still have power 0.5 s after the e-stop button is pressed.
# The hard-wired chain: button -> two-channel safety relay -> contactors K1 and K2 in series.
# Probabilities per demand are ILLUSTRATIVE numbers for the exercise, not data of any product.
EVENT button_contacts_fail   0.0001
EVENT relay_logic_fails      0.0002
EVENT K1_welded              0.001
EVENT K2_welded              0.001
EVENT overcurrent_welds_both 0.0005
GATE  K1_stays_closed OR  K1_welded overcurrent_welds_both
GATE  K2_stays_closed OR  K2_welded overcurrent_welds_both
GATE  both_contactors AND K1_stays_closed K2_stays_closed
GATE  power_not_cut   OR  button_contacts_fail relay_logic_fails both_contactors
TOP   power_not_cut
