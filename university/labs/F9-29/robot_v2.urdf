<?xml version="1.0"?>
<!-- F9-29 forensic: version 2 of the course robot model, edited after the arm was
     moved to the left side of the base. Written in the URDF XML format from the author's
     memory, NOT checked against the URDF specification in this build; only
     urdf_mini.hpp (this lab's own reader) has read this file. -->
<robot name="course_robot">
  <link name="base_link">
    <inertial><mass value="4.0"/></inertial>
  </link>
  <link name="left_wheel">
    <inertial><mass value="0.3"/></inertial>
  </link>
  <link name="right_wheel">
    <inertial><mass value="0.3"/></inertial>
  </link>
  <link name="arm_base"/>
  <link name="turret">
    <inertial><mass value="0.4"/></inertial>
  </link>
  <link name="upper_arm">
    <inertial><mass value="1.0"/></inertial>
  </link>
  <link name="forearm">
    <inertial><mass value="0.5"/></inertial>
  </link>
  <link name="tool"/>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.15 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.15 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="arm_mount" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin xyz="0.1 0.1 0.3" rpy="0 0 90"/>
  </joint>
  <joint name="base_yaw" type="revolute">
    <parent link="arm_base"/>
    <child link="turret"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416"/>
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="turret"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.6" upper="2.6"/>
  </joint>
  <joint name="tool_mount" type="fixed">
    <parent link="forearm"/>
    <child link="tool"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
  </joint>
</robot>
